---
// Header ligt transparant over de herofoto, met lichte tekst.
const items = [
  ['#diensten', 'Wat we doen'],
  ['#werk', 'Ons werk'],
  ['#over', 'Vader en zoon'],
  ['#offerte', 'Prijsopgave'],
];
---
<header class="absolute inset-x-0 top-0 z-20 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="flex items-center gap-2.5 font-display font-extrabold text-lg sm:text-xl tracking-tight">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 26V13l8-6 8 6v13h-5v-7h-6v7z" fill="#5b9bd5"/></svg>
      De Maas <span class="hidden min-[360px]:inline font-body font-medium text-sm sm:text-base tracking-normal text-mist">Schildersbedrijf</span>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-7 font-body font-semibold text-base">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-mist">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="tel:+31623600141" class="knop text-sm sm:text-base py-2.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span class="hidden sm:inline">06 23600141</span><span class="sm:hidden">Bel</span>
    </a>
  </div>
</header>
