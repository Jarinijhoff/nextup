---
import { Picture, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';
import steiger from '../assets/werk-steiger.jpg';
import vaderEnZoon from '../assets/werk-4.jpg';
import werk2 from '../assets/werk-2.jpg';

// Alle feiten hieronder komen van schildersbedrijfdemaas.nl (homepage, Diensten,
// Contact) en het Google-bedrijfsprofiel. Niets verzonnen; wat ontbreekt is een
// "Hier komt ..."-vlak.
const tel = '06 23600141';
const telHref = 'tel:+31623600141';
const waHref = 'https://wa.me/31623600141';
const mail = 'info@schildersbedrijfdemaas.nl';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Tjalk+77,+2991+PP+Barendrecht';

// Diensten zoals zij ze zelf noemen op de pagina Diensten.
const diensten = [
  { nr: '01', kop: 'Schilderwerk binnen en buiten', tekst: 'Muren, plafonds, gevels, kozijnen en deuren, voor particulieren en bedrijven. Met een goede verf, zoals Sikkens.' },
  { nr: '02', kop: 'Houtwerk en kozijnen repareren', tekst: 'Houtrot en beschadigd houtwerk herstellen voordat er geschilderd wordt, zodat het verfwerk lang meegaat.' },
  { nr: '03', kop: 'Steigerverhuur', tekst: 'Tegen scherpe prijzen, ook als je zelf aan de slag gaat.' },
  { nr: '04', kop: 'Een betrouwbare prijsopgave', tekst: 'Eerst kijken, dan een duidelijke prijs. Geen verrassingen achteraf.' },
];

// Werkgebied, letterlijk van hun homepage.
const plaatsen = ['Barendrecht', 'Rotterdam', 'Drechtsteden', 'Hoeksche Waard', 'Hoogvliet', 'Spijkenisse'];
---
<Layout
  title="Schildersbedrijf De Maas, Barendrecht: schilderwerk binnen en buiten"
  description="Vader en zoon schilderen in Barendrecht, Rotterdam, de Drechtsteden en de Hoeksche Waard. Binnen- en buitenschilderwerk, houtrotherstel en steigerverhuur. Bel of app 06 23600141 voor een prijsopgave."
  bedrijf="Schildersbedrijf De Maas"
  themeColor="#14213d"
  fonts={['archivo-latin-wght-normal.woff2', 'source-sans-3-latin-wght-normal.woff2']}
>
  <div id="top"></div>

  <!-- Hero: hun eigen werkfoto beeldvullend (Hashem op de ladder, spandoek), tekst linksonder. -->
  <section class="relative min-h-[78svh] lg:min-h-[92vh] flex flex-col text-white overflow-hidden">
    <Picture
      src={steiger}
      alt="Hashem Belanj schildert de boeidelen van een woning in Barendrecht, met steiger en het spandoek van De Maas"
      widths={[640, 1024, 1600, 2016]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: 'absolute inset-0' }}
      class="h-full w-full object-cover"
      style="object-position: 62% 40%"
    />
    <div class="absolute inset-0" aria-hidden="true" style="background:
      linear-gradient(to top, rgb(11 19 38 / 0.95) 0%, rgb(11 19 38 / 0.72) 40%, rgb(11 19 38 / 0.28) 72%, rgb(11 19 38 / 0.3) 100%),
      linear-gradient(to right, rgb(11 19 38 / 0.55) 0%, rgb(11 19 38 / 0) 65%);"></div>
    <Header />
    <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 mt-auto pt-40 pb-14 sm:pb-20 lg:pb-24">
      <p class="eyebrow text-mist mb-4">Vader en zoon, sinds 2011</p>
      <h1 class="text-[2.5rem]/[1] min-[360px]:text-4xl sm:text-5xl max-w-4xl">
        Schilderwerk binnen en buiten. Lokaal, betaalbaar, duurzaam.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-mist">
        Vanuit Barendrecht, voor Rotterdam, de Drechtsteden en de Hoeksche Waard. Stuur een paar foto&rsquo;s, dan krijg je een duidelijke prijs.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={waHref} class="knop text-lg px-6 py-3.5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.8.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4l-.4-.2-1.9-.9c-.3-.1-.4-.2-.6.2l-.9 1.1c-.2.2-.3.2-.6.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.1.1-.2 0-.4 0-.5l-.9-2.1c-.2-.5-.4-.5-.6-.5h-.4Z"/></svg>
          App {tel}
        </a>
        <a href={telHref} class="font-display font-bold text-lg link-lijn">Of bel</a>
      </div>
      <p class="mt-8 font-body text-sm text-mist">
        <span class="font-display font-extrabold text-white text-xl align-middle">5,0</span> op Google, uit 61 reviews
      </p>
    </div>
  </section>

  <main>
    <!-- Diensten: genummerde lijst met lijnen, in hun eigen woorden. -->
    <section id="diensten" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-3">Wat we doen</p>
          <h2 class="text-3xl sm:text-4xl">Van houtrot tot de laatste laklaag.</h2>
          <p class="mt-5 text-ink-soft max-w-sm">Voor woningen en bedrijfspanden. Eerst het houtwerk in orde, dan pas de verf.</p>
        </div>
        <ol class="lg:col-span-8 divide-y divide-paper-deep border-y border-paper-deep">
          {diensten.map((d) => (
            <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[5rem_1fr_1.2fr] gap-x-4 gap-y-1 py-5 sm:py-6 items-baseline">
              <span class="font-display font-extrabold text-2xl sm:text-3xl text-blue-text">{d.nr}</span>
              <h3 class="text-xl sm:text-2xl">{d.kop}</h3>
              <p class="col-start-2 sm:col-start-3 text-ink-soft">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Werk: een echte foto, de rest vlakken voor hun projectfoto's. -->
    <section id="werk" class="bg-ink text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-mist mb-3">Ons werk</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl">Zo ziet het eruit als wij klaar zijn.</h2>
          </div>
          <p class="lg:col-span-5 text-mist text-lg">Buitenschilderwerk, kozijnen, hele woningen van binnen. Voor en na, met het adres erbij als de klant dat goed vindt.</p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <Image src={werk2} alt="Steiger met het spandoek van De Maas voor een woning, Hashem aan het werk" widths={[480, 800]} sizes="(min-width: 640px) 400px, 50vw" quality={70} class="w-full aspect-[4/3] sm:aspect-square object-cover rounded-md sm:row-span-2 sm:aspect-auto sm:h-full" loading="lazy" />
          <Placeholder label="Hier komt een foto van buitenschilderwerk" class="aspect-[2/1] sm:aspect-square rounded-md" />
          <Placeholder label="Hier komt een foto van kozijnen, voor en na" class="aspect-[2/1] sm:aspect-square rounded-md" />
          <Placeholder label="Hier komt een foto van een woning van binnen" class="aspect-square rounded-md hidden sm:block" />
          <Placeholder label="Hier komt nog een project" class="aspect-square rounded-md hidden sm:block" />
        </div>
      </div>
    </section>

    <!-- Over ons: vader en zoon, hun eigen foto en hun eigen verhaal van de homepage. -->
    <section id="over" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <Image src={vaderEnZoon} alt="Payam en Hashem Belanj in werkkleding op tuinstoelen voor een woning in de steigers" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 460px, 100vw" quality={72} class="w-full aspect-[4/5] object-cover rounded-md" loading="lazy" style="object-position: 50% 60%" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="eyebrow mb-3">Vader en zoon</p>
          <h2 class="text-3xl sm:text-4xl">Hashem en Payam Belanj.</h2>
          <p class="mt-5 text-ink-soft text-lg">
            Schildersbedrijf De Maas is in 2011 opgericht door Hashem Belanj en zijn zoon Payam. Ze komen zelf kijken, maken zelf de prijs en doen zelf het werk. Scherpe prijzen en goed werk afleveren, daar is het bedrijf op gebouwd.
          </p>
          <div class="mt-8 rounded-md border border-dashed border-blue/40 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komen een paar van jullie 61 Google-reviews, na jullie akkoord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Werkgebied en prijsopgave: geen formulier, appen met foto's werkt sneller. -->
    <section id="offerte" class="bg-paper-deep/60">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-3">Prijsopgave</p>
          <h2 class="text-3xl sm:text-4xl">Stuur foto&rsquo;s, krijg een prijs.</h2>
          <p class="mt-5 text-ink-soft text-lg max-w-lg">
            App een paar foto&rsquo;s van het werk en je adres. Dan hoor je snel wat het kost, of we komen even kijken.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={waHref} class="knop text-lg px-6 py-3.5">App {tel}</a>
            <a href={telHref} class="font-display font-bold text-lg link-lijn">Bel {tel}</a>
          </div>
          <ul class="mt-8 space-y-2 text-lg">
            <li><a href={`mailto:${mail}`} class="link-lijn">{mail}</a></li>
            <li class="text-ink-soft">Tjalk 77, 2991 PP Barendrecht · <a href={route} target="_blank" rel="noopener" class="link-lijn text-ink">route</a></li>
          </ul>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="eyebrow mb-3">Werkgebied</p>
          <h3 class="text-2xl">Vanuit Barendrecht, de regio in.</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {plaatsen.map((p) => (
              <li class="border border-ink/25 rounded-sm px-3 py-1.5 font-body font-semibold text-ink">{p}</li>
            ))}
          </ul>
          <div class="mt-8 rounded-md border border-dashed border-blue/40 p-5 bg-paper">
            <p class="placeholder-label text-ink-soft">Hier komen jullie werktijden en de tijd waarbinnen je reageert op een aanvraag</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink-deep text-mist">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display font-extrabold text-2xl text-white">Schildersbedrijf De Maas</p>
        <p class="text-sm mt-1">Tjalk 77, 2991 PP Barendrecht · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan met bellen en appen. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink-deep">
    <a href={telHref} class="bg-white text-ink font-display font-bold text-base py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-blue text-white font-display font-bold text-base py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>
