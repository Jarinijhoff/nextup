---
import { Picture, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';
import tuin from '../assets/tuin-corten.jpg';
import grindtuin from '../assets/grindtuin.jpg';
import bestrating from '../assets/bestrating.jpg';
import overkapping from '../assets/overkapping.jpg';

// Alle teksten komen van rozima.nl, de Facebook-pagina en het Google-profiel van
// Rozima. Het nieuwe adres (Vroonweg) staat op Google en Facebook; de oude site noemt
// nog Stad aan 't Haringvliet. Niets verzonnen.
const mobiel = '06 10395970';
const mobielHref = 'tel:+31610395970';
const waHref = 'https://wa.me/31610395970';
const vast = '0187 612000';
const vastHref = 'tel:+31187612000';
const mail = 'info@rozima.nl';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Vroonweg+38,+3241+LT+Middelharnis';

const diensten = [
  { id: 'aanleg', kop: 'Aanleg en renovatie', tekst: 'Een nieuwe tuin of een bestaande tuin opnieuw: klassiek, modern, oosters of in landschapsstijl. We kijken altijd welke planten en materialen we kunnen houden.' },
  { id: 'onderhoud', kop: 'Onderhoud', tekst: 'Het hele jaar door, ook met een onderhoudscontract. Hoe vaak en voor welke prijs bepalen we samen met u.' },
  { id: 'bestrating', kop: 'Bestrating', tekst: 'Bestratingen als onderdeel van de aanleg of renovatie van uw tuin.' },
  { id: 'hekwerk', kop: 'Hekwerk en houtconstructies', tekst: 'Allerlei soorten hekwerk, schuttingen en overkappingen, gemaakt en geplaatst door ons eigen team.' },
];

// De werkwijze bij aanleg, in de volgorde die Rozima zelf beschrijft.
const stappen = [
  { kop: 'Kennismaken', tekst: 'We komen vrijblijvend langs en horen wat u wilt.' },
  { kop: 'Schets en begroting', tekst: 'U krijgt een schetsontwerp met een begroting, ook vrijblijvend.' },
  { kop: 'Definitief ontwerp', tekst: 'Samen werken we de schets uit tot het ontwerp.' },
  { kop: 'Aanleg', tekst: 'We leggen de tuin helemaal in eigen beheer aan.' },
];
---
<Layout
  title="Rozima Hoveniers, Middelharnis: ontwerp, aanleg en onderhoud van tuinen"
  description="Hoveniersbedrijf op Goeree-Overflakkee. Ontwerp, aanleg en onderhoud van tuinen, bestrating, hekwerk en houtconstructies. Vrijblijvend langskomen? Bel of app 06 10395970."
  bedrijf="Rozima Hoveniers"
  themeColor="#16261b"
  balkClass="bg-linen text-ink"
>
  <div id="top" class="relative bg-ink text-linen">
    <Header waHref={waHref} />

    <!-- Hero: een tuin die Rozima zelf aanlegde, beeldvullend; tekst links onderin. -->
    <section class="relative min-h-[82svh] lg:min-h-[96svh] flex items-end overflow-hidden">
      <Picture
        src={tuin}
        formats={['avif', 'webp']}
        widths={[480, 750, 1080, 1440, 2048]}
        quality={45}
        sizes="100vw"
        alt="Aangelegde tuin met een pad, gras, plantenbakken van cortenstaal en houten schermen met verlichting"
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'absolute inset-0' }}
        class="hero-foto h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/80 via-55% to-ink/35 lg:via-ink/70 lg:via-40% lg:to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/50 via-45% to-transparent" aria-hidden="true"></div>
      <!-- Zacht donker vlak achter het tekstblok: de lucht valt op sommige breedtes precies achter het label. -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_55%_at_22%_62%,rgb(22_38_27/0.6),transparent_70%)]" aria-hidden="true"></div>
      <!-- De bewolkte lucht bovenin is licht: een eigen verloop houdt de navigatie leesbaar. -->
      <div class="absolute inset-x-0 top-0 h-52 bg-gradient-to-b from-ink/90 via-ink/50 to-transparent" aria-hidden="true"></div>
      <div class="hero-tekst relative mx-auto w-full max-w-6xl px-5 sm:px-8 pb-10 sm:pb-14 pt-44">
        <p class="w-fit font-body font-bold text-sm uppercase tracking-[0.18em] text-linen mb-4">Hoveniersbedrijf op Goeree-Overflakkee</p>
        <h1 class="text-[clamp(2.5rem,11.5vw,4rem)] leading-[1.02] sm:text-5xl lg:text-6xl">
          Van droomtuin<br class="hidden sm:block" /> naar werkelijkheid.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-linen/90">
          Ontwerp, aanleg en onderhoud van tuinen, voor particulieren en bedrijven. Bestrating, hekwerk en houtconstructies doen we zelf.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={waHref} class="btn-rust">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6Z"/></svg>
            Plan een vrijblijvend bezoek
          </a>
          <a href={mobielHref} class="text-lg link-under">Of bel {mobiel}</a>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- Diensten: kop links, lijst rechts met lijnen. Geen kaartjes met iconen. -->
    <section id="diensten">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-3">Wat we doen</p>
          <h2 class="text-3xl sm:text-4xl">Tuinen in de ruimste zin van het woord.</h2>
          <p class="mt-5 text-fern text-lg">Sinds 2000, met zeven vaste, gediplomeerde vakmensen en eigen machines.</p>
        </div>
        <ul class="lg:col-span-7 lg:col-start-6 divide-y divide-linen-deep border-y border-linen-deep">
          {diensten.map((d) => (
            <li id={d.id} class="py-6 sm:py-7 grid sm:grid-cols-[14rem_1fr] gap-x-8 gap-y-2">
              <h3 class="text-xl sm:text-2xl">{d.kop}</h3>
              <p class="text-fern">{d.tekst}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Werkwijze: vier stappen op een lijn; laat zien dat een offerte niets kost. -->
    <section id="werkwijze" class="bg-moss text-linen">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="max-w-2xl">
          <p class="font-body font-bold text-sm uppercase tracking-[0.18em] text-rust-light mb-3">Zo werken we</p>
          <h2 class="text-3xl sm:text-4xl">Eerst praten, dan pas graven.</h2>
        </div>
        <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map((s, i) => (
            <li class="relative pt-8 border-t border-sage/40">
              <span class="absolute -top-[7px] left-0 h-3.5 w-3.5 rounded-full bg-rust-light" aria-hidden="true"></span>
              <p class="font-display text-sage text-lg" style="font-weight:600">Stap {i + 1}</p>
              <h3 class="mt-1 text-2xl">{s.kop}</h3>
              <p class="mt-2 text-sage">{s.tekst}</p>
            </li>
          ))}
        </ol>
        <a href={waHref} class="btn-rust mt-12">Plan een kennismaking</a>
      </div>
    </section>

    <!-- Projecten: een groot beeld en twee kleinere, met wat het is eronder. -->
    <section id="werk">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow mb-3">Projecten</p>
            <h2 class="text-3xl sm:text-4xl">Recent werk.</h2>
          </div>
          <a href="https://www.facebook.com/rozimahovenier" target="_blank" rel="noopener" class="link-under">Meer op Facebook</a>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-12">
          <figure class="lg:col-span-7">
            <Image src={overkapping} alt="Medewerker van Rozima bouwt een houten overkapping boven een schommel" widths={[400, 650, 960, 1280]} quality={65} sizes="(min-width: 1024px) 640px, 100vw" class="w-full aspect-[4/3] object-cover rounded-md" />
            <figcaption class="mt-3 text-fern"><strong class="text-ink">Overkapping bij De Zuidwester</strong>, september 2026: zodat de schommel ook bij regen gebruikt kan worden.</figcaption>
          </figure>
          <div class="lg:col-span-5 grid gap-5">
            <figure>
              <Image src={grindtuin} alt="Voortuin met grind, siergrassen en coniferen voor een witte woning" widths={[400, 650, 900]} quality={65} sizes="(min-width: 1024px) 440px, 100vw" class="w-full aspect-[16/10] object-cover rounded-md" />
              <figcaption class="mt-3 text-fern"><strong class="text-ink">Aanleg</strong>: voortuin met grind en siergrassen.</figcaption>
            </figure>
            <figure>
              <Image src={bestrating} alt="Vlonder, tegelpad en gras sluiten strak op elkaar aan" widths={[400, 650, 900]} quality={65} sizes="(min-width: 1024px) 440px, 100vw" class="w-full aspect-[16/10] object-cover rounded-md" />
              <figcaption class="mt-3 text-fern"><strong class="text-ink">Bestrating</strong>: vlonder, tegels en gras.</figcaption>
            </figure>
          </div>
        </div>
        <div class="mt-6 border-2 border-dashed border-fern/40 rounded-md p-5 sm:p-6">
          <p class="placeholder-label text-fern">Hier komen meer projecten, met voor- en nafoto’s, uit jullie eigen archief</p>
        </div>
      </div>
    </section>

    <!-- Over Rozima: wat ze zelf vertellen over de naam en het team. -->
    <section id="over" class="bg-ink text-linen">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <Placeholder label="Hier komt een foto van het team bij de bussen" class="aspect-[4/3] rounded-md" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="font-body font-bold text-sm uppercase tracking-[0.18em] text-rust-light mb-3">Over Rozima</p>
          <h2 class="text-3xl sm:text-4xl">Een familiebedrijf met een naam die iets zegt.</h2>
          <p class="mt-5 text-sage text-lg">
            Rozima komt van de eerste twee letters van de directieleden, Van Rossum en Van Zielst, en van hun vrouwen, Van der Mast en Maliepaard. Alle medewerkers zijn gediplomeerd, met VCA, spuitlicentie en BHV, en we werken met professionele machines.
          </p>
          <div class="mt-8 border-2 border-dashed border-sage/40 rounded-md p-5 sm:p-6">
            <p class="placeholder-label">Hier komen twee of drie reacties van klanten, na hun akkoord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: geen formulier in de schets, bellen of appen gaat het snelst. -->
    <section id="contact">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Contact</p>
          <h2 class="text-3xl sm:text-4xl">We komen graag vrijblijvend langs.</h2>
          <p class="mt-5 text-fern text-lg">Op Goeree-Overflakkee en verder in Zuid-Holland en Zeeland, voor particulieren en bedrijven.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 grid gap-8 sm:grid-cols-2">
          <div>
            <address class="not-italic text-lg text-fern">
              Rozima Hoveniers<br />
              Vroonweg 38<br />
              3241 LT Middelharnis
            </address>
            <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block link-under">Routebeschrijving</a>
          </div>
          <ul class="space-y-4">
            <li>
              <span class="block text-sm text-fern">Mobiel en WhatsApp</span>
              <a href={mobielHref} class="font-display text-2xl hover:text-rust" style="font-weight:800">{mobiel}</a>
            </li>
            <li>
              <span class="block text-sm text-fern">Kantoor</span>
              <a href={vastHref} class="font-display text-xl hover:text-rust" style="font-weight:700">{vast}</a>
            </li>
            <li>
              <span class="block text-sm text-fern">E-mail</span>
              <a href={`mailto:${mail}`} class="link-under">{mail}</a>
            </li>
          </ul>
          <div class="sm:col-span-2 border-2 border-dashed border-fern/40 rounded-md p-5 sm:p-6">
            <p class="placeholder-label text-fern">Hier komen jullie openingstijden en hoe snel jullie reageren op een aanvraag</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-sage">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display text-2xl text-linen" style="font-weight:800;letter-spacing:-0.03em">Rozima Hoveniers</p>
        <p class="text-sm mt-1">Vroonweg 38, 3241 LT Middelharnis · <a href={mobielHref} class="underline underline-offset-2 hover:text-linen">{mobiel}</a> · KvK 24304762</p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-linen">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink">
    <a href={mobielHref} class="bg-linen text-ink font-bold text-lg py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-rust text-white font-bold text-lg py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>

<style>
  /* Uitsnede: het pad en de cortenstalen bak blijven in beeld; op smal scherm iets
     naar rechts, waar de boom en de bak staan. */
  .hero-foto { object-position: 50% 60%; }
  @media (max-width: 767px) { .hero-foto { object-position: 62% 60%; } }
</style>
