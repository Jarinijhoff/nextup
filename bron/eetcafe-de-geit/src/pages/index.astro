---
import { Picture, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import cafeBar from '../assets/cafe-bar.jpg';
import cafeDarts from '../assets/cafe-darts.jpg';
import eigenaren from '../assets/eigenaren.jpg';
import muntjes from '../assets/muntjes.jpg';

// Bronnen: Google-profiel (adres, 06, openingstijden, score, foto's van het interieur),
// de eigen Instagram (team, bord met lokale specialiteiten, muntjes, overname april 2024),
// Facebook (slogan, live muziek, voetbal) en de papieren kaart (gerechten).
// Prijzen laten we weg tot het café ze bevestigt.
const tel = '06 10890153';
const telHref = 'tel:+31610890153';
const waHref = 'https://wa.me/31610890153';
const mail = 'eetcafedegeit@icloud.com';
const facebook = 'https://www.facebook.com/eetcafedegeit/';
const instagram = 'https://www.instagram.com/eetcafedegeit/';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Kaai+1,+3255+AG+Oude-Tonge';

// Een greep uit de kaart, in de woorden van de kaart zelf.
const bord = [
  { naam: 'Spareribs', tekst: 'Zeeuws scharrelvarken, gewoon lekker of pittig met sambal van Kadhir.' },
  { naam: 'Hamburger zoals die bedoeld is', tekst: 'Met onder andere bacon en kaas, burger van Beestenboel van Verweij.' },
  { naam: 'Bouw je eigen burger', tekst: 'Broodje, saus, burger en extra’s: je kruist het aan op het briefje.' },
  { naam: 'Schnitzel', tekst: 'Varken of kip, met peper- of champignonsaus of gebakken zooi.' },
  { naam: 'Beladen patatje', tekst: 'Met stoofvlees, vega stoof of kipshoarma.' },
  { naam: 'Rode bieten taart', tekst: 'Met verse geitenkaas. Hoe kan het ook anders, bij de Geit.' },
];

// Openingstijden volgens het Google-bedrijfsprofiel, 2 oktober 2026.
const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', '12:00 tot 22:00'],
  ['Woensdag', '12:00 tot 22:00'],
  ['Donderdag', '12:00 tot 22:00'],
  ['Vrijdag', '12:00 tot 02:00'],
  ['Zaterdag', '11:00 tot 02:00'],
  ['Zondag', '11:00 tot 22:00'],
];
---
<Layout
  title="Eetcafé de Geit, Oude-Tonge: de kaart, openingstijden en reserveren"
  description="Eetcafé aan de Kaai in Oude-Tonge. Spareribs, burgers en schnitzels met vlees van lokale boeren, darts, voetbal en live muziek. Reserveren via WhatsApp op 06 10890153."
  bedrijf="Eetcafé de Geit"
  themeColor="#1e211f"
  balkClass="bg-ink text-cream"
>
  <div id="top" class="relative bg-board text-chalk">
    <Header waHref={waHref} />

    <!-- Hero: de gelagkamer zelf, beeldvullend; krijtletters links onderin. -->
    <section class="relative min-h-[96svh] lg:min-h-[96svh] flex items-end overflow-hidden">
      <Picture
        src={cafeBar}
        formats={['avif', 'webp']}
        widths={[480, 750, 1080, 1440, 2000]}
        quality={55}
        sizes="100vw"
        alt="De gelagkamer van Eetcafé de Geit: houten vloer, koperen lampen boven de bar en oranje vlaggetjes"
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'absolute inset-0' }}
        class="hero-foto h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-board via-board/85 via-55% to-board/10 lg:via-board/70 lg:via-45% lg:to-board/10" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-board/90 via-board/55 via-45% to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-x-0 top-0 h-36 lg:h-44 bg-gradient-to-b from-board/80 to-transparent" aria-hidden="true"></div>
      <div class="hero-tekst relative mx-auto w-full max-w-6xl px-5 sm:px-8 pb-12 sm:pb-16 pt-44">
        <p class="w-fit font-body font-bold text-sm uppercase tracking-[0.16em] text-chalk mb-4">Aan de Kaai in Oude-Tonge</p>
        <h1 class="text-[clamp(2.7rem,12.5vw,4.3rem)] leading-[1] sm:text-5xl lg:text-6xl">
          <span class="whitespace-nowrap">Lekker eten,</span><br /><span class="whitespace-nowrap">lekker drinken,</span><br /><span class="whitespace-nowrap text-brick-light">lekker gezellig.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-chalk/90">
          En lekker lokaal: burgers en spareribs met vlees van boeren uit de buurt, een goed glas bier, darts aan de muur en elke tweede zondagmiddag van de maand live muziek.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={waHref} class="btn-brick">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6Z"/></svg>
            Reserveer via WhatsApp
          </a>
          <a href="#bord" class="text-lg link-under decoration-brick-light">Wat staat er op het bord?</a>
        </div>
        <p class="hidden sm:block mt-8 w-fit text-sm text-chalk/85">Maandag gesloten · vrijdag en zaterdag open tot 02:00</p>
      </div>
    </section>
  </div>

  <main>
    <!-- Het bord: de kaart als krijtbord in een houten lijst, zoals in het café.
         Als HTML, niet als foto of PDF: leesbaar op de telefoon en vindbaar in Google. -->
    <section id="bord" class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-8">
        <div class="krijtbord px-6 py-10 sm:px-12 sm:py-14">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-6">
              <p class="font-display text-xl text-chalk-soft">Eetcafé de Geit</p>
              <h2 class="text-4xl sm:text-5xl">Van het bord</h2>
            </div>
            <p class="lg:col-span-6 text-chalk-soft text-lg">
              Ons bord verandert regelmatig, naar het aanbod van de lokale boeren. Dit staat er vaak op:
            </p>
          </div>
          <ul class="mt-10 grid gap-x-12 sm:grid-cols-2">
            {bord.map((g) => (
              <li class="border-t krijt-lijn py-5">
                <h3 class="text-2xl sm:text-[1.75rem]">{g.naam}</h3>
                <p class="mt-1 text-chalk-soft">{g.tekst}</p>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-chalk-soft">Hoofdgerechten worden zonder bijgerechten geserveerd. Patat en snacks kun je ook meenemen.</p>
          <div class="mt-8 border-2 krijt-lijn rounded-sm p-5">
            <p class="font-display text-xl text-chalk-soft">Hier komt jullie hele kaart, met de actuele prijzen en de chef special</p>
          </div>
        </div>
      </div>
    </section>

    <!-- In het café: eigen foto's en wat er te doen is. -->
    <section id="cafe" class="pb-16 sm:pb-24">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 grid gap-10 lg:grid-cols-12">
        <figure class="lg:col-span-7">
          <Image src={cafeDarts} alt="Dartborden en vlaggetjes aan de groene muur, met het krijtbord van de Geit met de agenda" widths={[480, 750, 1080, 1400]} quality={60} sizes="(min-width: 1024px) 640px, 100vw" class="w-full aspect-[4/3] object-cover rounded-md" />
          <figcaption class="mt-3 font-display text-xl text-earth">Darts, vlaggetjes en de agenda op het bord.</figcaption>
        </figure>
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">In het café</p>
          <h2 class="text-4xl sm:text-5xl">Er is altijd wat.</h2>
          <dl class="mt-8 space-y-5">
            <div>
              <dt class="font-display text-2xl">Live muziek</dt>
              <dd class="text-earth">Elke tweede zondagmiddag van de maand.</dd>
            </div>
            <div>
              <dt class="font-display text-2xl">Voetbal kijken</dt>
              <dd class="text-earth">Speelt Nederland, dan staat het aan.</dd>
            </div>
            <div>
              <dt class="font-display text-2xl">Darts en kaarten</dt>
              <dd class="text-earth">Een potje darten of klaverjassen met de vaste gasten.</dd>
            </div>
            <div>
              <dt class="font-display text-2xl">Avonden met een thema</dt>
              <dd class="text-earth">Pannenkoeken, barbecue of de jukebox. Kijk op <a href={facebook} target="_blank" rel="noopener" class="link-under">Facebook</a> of <a href={instagram} target="_blank" rel="noopener" class="link-under">Instagram</a>.</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- De huisregels van het bord bij de bar, en de muntjes met de geit. -->
      <div class="mx-auto max-w-6xl px-5 sm:px-8 mt-12 grid gap-8 lg:grid-cols-12 lg:items-center">
        <blockquote class="lg:col-span-7 krijtbord px-7 py-8 sm:px-10 sm:py-10">
          <p class="font-display text-3xl sm:text-4xl leading-tight">Onze geiten houden van iedereen.</p>
          <p class="mt-3 font-display text-2xl text-chalk-soft">Mekkeren is toegestaan, maar doeslief.</p>
          <footer class="mt-5 text-sm text-chalk-soft">Van het bord met huisregels in het café</footer>
        </blockquote>
        <figure class="lg:col-span-4 lg:col-start-9 flex items-center gap-5">
          <Image src={muntjes} alt="Een zak vol houten muntjes met een geit erop" widths={[240, 480]} quality={65} sizes="160px" class="w-32 sm:w-40 aspect-square object-cover rounded-md shrink-0" />
          <figcaption class="text-earth">Op drukke feestavonden, zoals Koningsnacht, betaal je met muntjes van de Geit.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Over ons: het team voor de deur, foto van hun eigen Instagram. -->
    <section id="over" class="bg-ink text-cream">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5 lg:order-2 lg:col-start-8">
          <Image src={eigenaren} alt="Het team van Eetcafé de Geit voor de deur aan de Kaai, met duim omhoog" widths={[400, 650, 1000]} quality={65} sizes="(min-width: 1024px) 460px, 100vw" class="w-full aspect-[8/7] object-cover rounded-md" />
        </div>
        <div class="lg:col-span-6 lg:order-1">
          <p class="font-body font-bold text-sm uppercase tracking-[0.16em] text-brick-light mb-3">Over ons</p>
          <h2 class="text-4xl sm:text-5xl">Een echt dorpscafé, aan de haven.</h2>
          <p class="mt-5 text-oat text-lg">
            Sinds april 2024 staat de Geit aan de Kaai, in het pand van het voormalige Grand Café Buutegeweun. Bij mooi weer zit je buiten op het terras. Op Google geven 51 gasten de Geit gemiddeld een 4,6.
          </p>
          <div class="mt-8 border-2 border-dashed border-oat/40 rounded-md p-5">
            <p class="placeholder-label">Hier stellen jullie jezelf voor: wie er achter de bar staat en waarom de Geit</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Open en reserveren. -->
    <section id="praktisch">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Open en reserveren</p>
          <h2 class="text-4xl sm:text-5xl">Een tafel? Stuur even een appje.</h2>
          <p class="mt-5 text-earth text-lg">Reserveren gaat het snelst via WhatsApp of even bellen.</p>
          <ul class="mt-6 space-y-4">
            <li><a href={waHref} class="font-display text-4xl hover:text-brick">{tel}</a></li>
            <li><a href={`mailto:${mail}`} class="inline-block py-2 link-under break-all">{mail}</a></li>
          </ul>
          <address class="not-italic mt-8 text-lg text-earth">
            Eetcafé de Geit<br />
            Kaai 1<br />
            3255 AG Oude-Tonge
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block link-under">Routebeschrijving</a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <table class="w-full text-left border-t border-cream-deep">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map(([dag, uren]) => (
                <tr class="border-b border-cream-deep">
                  <th scope="row" class="py-3 pr-4 font-semibold w-36">{dag}</th>
                  <td class:list={['py-3', uren === 'Gesloten' ? 'text-earth' : 'text-ink']}>{uren}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-4 text-sm text-earth">Tijden volgens het Google-profiel.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-board text-chalk-soft">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display text-3xl text-chalk">Eetcafé de Geit</p>
        <p class="text-sm mt-1">Kaai 1, 3255 AG Oude-Tonge · <a href={telHref} class="underline underline-offset-2 hover:text-chalk">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-chalk">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink">
    <a href={telHref} class="bg-cream text-ink font-bold text-lg py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-brick text-white font-bold text-lg py-3.5 text-center">Reserveer</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>

<style>
  /* Uitsnede: de bar met de koperen lampen blijft in beeld; de gast rechts aan de
     rand valt weg. Op smal scherm schuift het beeld naar de bar. */
  .hero-foto { object-position: 40% 55%; }
  @media (max-width: 767px) { .hero-foto { object-position: 30% 55%; } }
</style>
