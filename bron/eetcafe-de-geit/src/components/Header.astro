---
// Lichte header op crème: deze hero heeft (nog) geen foto, dus geen transparante
// header nodig. Op mobiel staan bellen en appen in de vaste balk onderaan.
const items = [
  ['#kaart', 'De kaart'],
  ['#cafe', 'In het café'],
  ['#over', 'Over ons'],
  ['#praktisch', 'Open en reserveren'],
];
const { waHref } = Astro.props;
---
<header class="sticky top-0 z-20 bg-cream/95 backdrop-blur border-b border-cream-deep">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="font-display text-2xl sm:text-[1.7rem] leading-none" style="font-weight:800;letter-spacing:-0.03em">
      Eetcafé <span class="text-brick">de Geit</span>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-semibold">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-brick">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={waHref} class="hidden sm:inline-flex btn-brick !py-2.5 !text-base">Reserveer via WhatsApp</a>
  </div>
</header>
