---
// Header ligt transparant over de foto van het café, met een krijtletter-woordmerk.
// Op mobiel staan bellen en reserveren in de vaste balk onderaan.
const items = [
  ['#bord', 'Het bord'],
  ['#cafe', 'In het café'],
  ['#over', 'Over ons'],
  ['#praktisch', 'Open en reserveren'],
];
const { waHref } = Astro.props;
---
<header class="absolute top-0 inset-x-0 z-20 text-chalk">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between gap-4 h-20 sm:h-24">
    <a href="#top" class="font-display text-[1.7rem] sm:text-3xl leading-none" style="font-weight:700">
      Eetcafé de Geit
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-semibold">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-brick-light">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={waHref} class="hidden sm:inline-flex items-center border-2 border-chalk/70 font-semibold px-4 py-2 rounded-md hover:border-brick-light hover:text-brick-light">Reserveer via WhatsApp</a>
  </div>
</header>
