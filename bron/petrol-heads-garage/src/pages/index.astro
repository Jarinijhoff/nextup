---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';
import werkplaats from '../assets/werkplaats.jpg';

// Alle feiten hieronder komen van petrolheadsgarage.nl, het Google-bedrijfsprofiel,
// de Facebook-intro en het LinkedIn-profiel van Frank Wuijts. Niets verzonnen.
// Openingstijden staan nergens volledig: die komen van de garage zelf.
const vast = '0161 700 234';
const vastHref = 'tel:+31161700234';
const mobiel = '06 58888441';
const waHref = 'https://wa.me/31658888441';
const mail = 'info@petrolheadsgarage.nl';
// Het aanbod blijft voorlopig op de bestaande Mobilox-pagina; in de echte site komt
// daar een koppeling met dezelfde voorraad.
const aanbod = 'https://petrolheadsgarage.nl/aanbod';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Pastoor+Gillisstraat+18C,+5121+CE+Rijen';

const werk = [
  { kop: 'Onderhoud en reparatie', tekst: 'Aan alle merken auto’s en bestelbussen.' },
  { kop: 'APK', tekst: 'Keuring voor je auto of bestelbus, in de eigen werkplaats.' },
  { kop: 'Automaatbak spoelen', tekst: 'Onderhoud aan je automatische versnellingsbak.' },
  { kop: 'Trekhaakmontage', tekst: 'Een trekhaak onder je auto, voor de aanhanger of de fietsendrager.' },
];
---
<Layout
  title="Petrol Heads Garage, Rijen: onderhoud, APK en occasions"
  description="Garage in Rijen voor onderhoud, reparatie en APK van alle merken, plus in- en verkoop van occasions. App Frank direct op 06 58888441."
  bedrijf="Petrol Heads Garage"
  themeColor="#121110"
  balkClass="bg-orange text-ink"
>
  <div id="top" class="relative bg-ink text-concrete">
    <Header waHref={waHref} />

    <!-- Hero: de eigen werkplaats beeldvullend, donker verloop van onderen en links,
         kop links onderin. -->
    <section class="hero relative min-h-[80svh] lg:min-h-[94svh] flex items-end overflow-hidden">
      <Picture
        src={werkplaats}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'absolute inset-0' }}
        class="hero-foto h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/85 via-60% to-ink/45 lg:via-ink/80 lg:via-35% lg:to-ink/30" aria-hidden="true"></div>
      <!-- Het daklicht bovenin de foto is fel: een eigen verloop houdt de navigatie leesbaar. -->
      <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-ink/85 to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink/80 via-ink/30 via-55% to-transparent" aria-hidden="true"></div>
      <div class="hero-tekst relative mx-auto w-full max-w-6xl px-5 sm:px-8 pb-12 sm:pb-16 pt-44">
        <p class="flex items-center gap-3 font-body font-bold text-sm uppercase tracking-[0.16em] text-concrete mb-4"><span class="h-0.5 w-8 bg-orange" aria-hidden="true"></span>Garage en occasions in Rijen</p>
        <h1 class="text-[clamp(2.3rem,10.5vw,3.5rem)] sm:text-5xl leading-[1.02] max-w-5xl">
          Werkplaats én occasions.<br />Alle merken.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-concrete/90">
          Onderhoud, reparatie en APK voor auto’s en bestelbussen, en een wisselend aanbod occasions. Een vraag? Je hebt Frank direct aan de lijn.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={waHref} class="btn-orange">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6Z"/></svg>
            App Frank<span class="hidden min-[360px]:inline">: {mobiel}</span>
          </a>
          <a href="#occasions" class="text-lg link-under">Bekijk de occasions</a>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- Werkplaats: twee kolommen met lijnen erboven, geen kaartjes met iconen. -->
    <section id="werkplaats">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow mb-3">Werkplaats</p>
            <h2 class="text-3xl sm:text-4xl">Onderhoud en APK voor elk merk.</h2>
          </div>
          <p class="lg:col-span-5 text-oil text-lg">Personenauto of bestelbus, elk merk: het gaat de brug op in onze eigen werkplaats aan de Pastoor Gillisstraat.</p>
        </div>
        <ul class="mt-12 grid gap-x-12 sm:grid-cols-2">
          {werk.map((w) => (
            <li class="border-t-2 border-ink py-6">
              <h3 class="text-xl sm:text-2xl">{w.kop}</h3>
              <p class="mt-2 text-oil">{w.tekst}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-lg">
          Afspraak maken? Bel <a href={vastHref} class="link-under">{vast}</a> of app <a href={waHref} class="link-under">{mobiel}</a>.
        </p>
      </div>
    </section>

    <!-- Occasions: donker vlak. Geen auto's of prijzen op de site zelf, die veranderen dagelijks. -->
    <section id="occasions" class="bg-ink text-concrete">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="font-body font-bold text-sm uppercase tracking-[0.16em] text-orange mb-3">Occasions</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl">Gebruikte auto’s van alle merken.</h2>
            <p class="mt-5 text-steel text-lg max-w-xl">In- en verkoop van occasions, met foto’s en alle gegevens per auto. Financiering regelen we voor je.</p>
          </div>
          <div class="lg:col-span-5 lg:text-right">
            <a href={aanbod} target="_blank" rel="noopener" class="btn-orange">
              Bekijk het aanbod
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {[1, 2, 3].map((n) => (
            <div class:list={['border border-steel/30 rounded-sm flex items-end p-5 min-h-40 sm:min-h-56', n > 1 && 'hidden sm:flex']}>
              <span class="placeholder-label">{n === 1 ? 'Hier komt jullie actuele voorraad, rechtstreeks uit Mobilox' : 'Auto uit het aanbod'}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Over ons: alleen wat openbaar bekend is; de rest vertelt Frank zelf. -->
    <section id="frank">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-3">Over ons</p>
          <h2 class="text-3xl sm:text-4xl">Een garage met een eigenaar die je kent.</h2>
          <p class="mt-5 text-oil text-lg">
            Petrol Heads Garage is de zaak van Frank Wuijts, aan de Pastoor Gillisstraat 18C in Rijen. Op Google geven 93 klanten gemiddeld een 4,8, en Frank reageert er zelf op.
          </p>
          <div class="mt-8 border-2 border-dashed border-oil/40 rounded-sm p-5 sm:p-6">
            <p class="placeholder-label text-oil">Hier komt jullie eigen verhaal: sinds wanneer, wie er werkt en waar jullie goed in zijn</p>
          </div>
          <div class="mt-4 border-2 border-dashed border-oil/40 rounded-sm p-5 sm:p-6">
            <p class="placeholder-label text-oil">Hier komen twee of drie echte Google-reviews, na jullie akkoord</p>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <Placeholder label="Hier komt een foto van Frank in de werkplaats" class="aspect-[4/5] rounded-sm" />
        </div>
      </div>
    </section>

    <!-- Contact: adres, nummers, tijden. Geen formulier in de schets. -->
    <section id="contact" class="border-t-2 border-ink">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Contact</p>
          <h2 class="text-3xl sm:text-4xl">Langskomen in Rijen.</h2>
          <address class="not-italic mt-6 text-lg text-oil">
            Petrol Heads Garage<br />
            Pastoor Gillisstraat 18C<br />
            5121 CE Rijen
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block link-under">Routebeschrijving</a>
        </div>
        <div class="lg:col-span-7 grid gap-8 sm:grid-cols-2">
          <ul class="space-y-4">
            <li>
              <span class="block text-sm text-oil">Werkplaats en verkoop</span>
              <a href={vastHref} class="font-display text-2xl hover:text-orange-text">{vast}</a>
            </li>
            <li>
              <span class="block text-sm text-oil">Frank direct, ook WhatsApp</span>
              <a href={waHref} class="font-display text-2xl hover:text-orange-text">{mobiel}</a>
            </li>
            <li>
              <span class="block text-sm text-oil">E-mail</span>
              <a href={`mailto:${mail}`} class="link-under break-all">{mail}</a>
            </li>
          </ul>
          <div class="border-2 border-dashed border-oil/40 rounded-sm p-5 sm:p-6 self-start">
            <p class="font-display text-xl">Openingstijden</p>
            <p class="mt-2 placeholder-label text-oil">Hier komen jullie openingstijden, zodat niemand voor een dichte deur staat</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-steel">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display text-2xl text-concrete">Petrol Heads Garage</p>
        <p class="text-sm mt-1">Pastoor Gillisstraat 18C, 5121 CE Rijen · <a href={vastHref} class="underline underline-offset-2 hover:text-concrete">{vast}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-concrete">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink">
    <a href={vastHref} class="bg-concrete text-ink font-bold text-lg py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-orange text-ink font-bold text-lg py-3.5 text-center">WhatsApp Frank</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>

<style>
  /* Uitsnede: de bus op de brug blijft in beeld; op smal scherm iets naar links,
     zodat de bus niet achter de tekst verdwijnt. */
  .hero-foto { object-position: 45% 40%; }
</style>
