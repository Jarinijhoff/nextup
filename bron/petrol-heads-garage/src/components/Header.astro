---
// Header ligt transparant over de werkplaatsfoto. Het logo is de bestaande badge van
// de garage; op mobiel staan bellen en appen in de vaste balk onderaan.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const items = [
  ['#werkplaats', 'Werkplaats'],
  ['#occasions', 'Occasions'],
  ['#frank', 'Over ons'],
  ['#contact', 'Contact'],
];
const { waHref } = Astro.props;
---
<header class="absolute top-0 inset-x-0 z-20 text-concrete">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between gap-4 h-20 sm:h-24">
    <a href="#top" aria-label="Petrol Heads Garage, naar boven">
      <Image src={logo} alt="" width={104} densities={[1, 2]} class="h-14 sm:h-16 w-auto" loading="eager" />
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-7 font-semibold">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-orange">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={waHref} class="hidden sm:inline-flex items-center gap-2 border-2 border-orange text-concrete font-semibold px-4 py-2 rounded-sm hover:bg-orange hover:text-ink">
      App Frank
    </a>
  </div>
</header>
