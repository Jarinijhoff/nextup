---
import { Image } from 'astro:assets';
import logo from '../assets/logo-kleijn-autos.jpg';
const items = [
  ['#diensten', 'Diensten'],
  ['#occasions', 'Occasions'],
  ['#over', 'Over ons'],
  ['#praktisch', 'Adres en tijden'],
];
---
<header class="sticky top-0 z-20 bg-paper/95 backdrop-blur border-b border-paper-deep">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="flex items-center gap-3" aria-label="Kleijn Auto's, naar boven">
      <Image src={logo} alt="" width="140" height="85" class="h-11 sm:h-14 w-auto mix-blend-multiply" loading="eager" />
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-7 font-display font-bold uppercase text-lg tracking-wide">
        {items.map(([href, label]) => (
          <li><a href={href} class="text-ink hover:text-accent-text">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="tel:+31657552916" class="inline-flex items-center gap-2 bg-accent text-ink font-display font-extrabold uppercase text-base sm:text-lg tracking-wide px-4 sm:px-5 py-2.5 rounded-sm hover:bg-accent-deep">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span class="hidden sm:inline">06 57552916</span><span class="sm:hidden">Bel</span>
    </a>
  </div>
</header>
