---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';

// Alle feiten hieronder komen van kleijnautos.nl, het Google-bedrijfsprofiel,
// de Facebook-pagina en de Autowereld-pagina van Kleijn Auto's. Niets verzonnen.
const tel = '06 57552916';
const telHref = 'tel:+31657552916';
const waHref = 'https://wa.me/31657552916';
const mail = 'info@kleijnautos.nl';
const autowereld = 'https://www.autowereld.nl/aanbieder/kleijn-autos-976784/auto.html';
const route = 'https://www.google.com/maps/dir/?api=1&destination=De+Leeuw+6,+3284+XV+Zuid-Beijerland';

// Openingstijden volgens het Google-bedrijfsprofiel (oktober 2026).
const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', '08:30 tot 17:30'],
  ['Woensdag', '08:30 tot 17:30'],
  ['Donderdag', '08:30 tot 17:30'],
  ['Vrijdag', '08:30 tot 17:30'],
  ['Zaterdag', '10:00 tot 14:00'],
  ['Zondag', '10:00 tot 14:00'],
];

const diensten = [
  { nr: '01', kop: 'Reparatie en onderhoud', tekst: 'Voor elke personenauto en lichte bedrijfswagen, ongeacht het merk.' },
  { nr: '02', kop: 'APK-keuring', tekst: 'Voor personenauto\u2019s en lichte bedrijfswagens.' },
  { nr: '03', kop: 'Occasions', tekst: 'Gebruikte personenauto’s, van klein en goedkoop tot jong gebruikt.' },
  { nr: '04', kop: 'Lichte bedrijfswagens', tekst: 'Bestelbussen voor het werk: onderhoud, reparatie en verkoop.' },
];
---
<Layout
  title="Kleijn Auto's, Zuid-Beijerland: reparatie, APK en occasions"
  description="Autobedrijf in Zuid-Beijerland voor reparatie, onderhoud en APK van personenauto's en lichte bedrijfswagens, en verkoop van occasions. Bel of app 06 57552916."
>
  <div id="top"></div>
  <Header />

  <main>
    <!-- Hero: tekst links, zwaar en strak; rechts het vlak voor de foto van de zaak. -->
    <section class="relative overflow-hidden">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 sm:pt-16 pb-12 sm:pb-20 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-4">Autobedrijf in Zuid-Beijerland</p>
          <h1 class="text-4xl sm:text-5xl text-ink">
            Reparatie, APK en occasions.<br /><span class="text-ink-soft">Voor auto en bedrijfsbus.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">
            Personenauto&rsquo;s en lichte bedrijfswagens, alle merken. Bel of app voor een afspraak of een vraag over een auto uit het aanbod.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={telHref} class="inline-flex items-center gap-2 bg-ink text-paper font-display font-extrabold uppercase text-xl tracking-wide px-6 py-3.5 rounded-sm hover:bg-ink-deep">
              Bel {tel}
            </a>
            <a href={waHref} class="inline-flex items-center gap-2 font-display font-bold uppercase text-xl tracking-wide text-ink underline underline-offset-4 decoration-2 decoration-accent hover:decoration-ink">
              Stuur een WhatsApp
            </a>
          </div>
          <dl class="mt-10 grid grid-cols-2 gap-6 max-w-md text-sm text-ink-soft">
            <div>
              <dt class="font-display font-bold uppercase tracking-wide text-ink">Adres</dt>
              <dd>De Leeuw 6<br />3284 XV Zuid-Beijerland</dd>
            </div>
            <div>
              <dt class="font-display font-bold uppercase tracking-wide text-ink">Open</dt>
              <dd>Di t/m vr 08:30 tot 17:30<br />Za en zo 10:00 tot 14:00</dd>
            </div>
          </dl>
        </div>
        <div class="lg:col-span-5">
          <Placeholder label="Hier komt een foto van de werkplaats aan De Leeuw 6" class="aspect-[4/3] lg:aspect-[4/5] rounded-md" />
        </div>
      </div>
    </section>

    <!-- Diensten: genummerde lijst met lijnen, geen kaartjes met icoontjes. -->
    <section id="diensten" class="border-t border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-3">Wat we doen</p>
          <h2 class="text-3xl sm:text-4xl">Dit doen we.</h2>
          <p class="mt-5 text-ink-soft max-w-sm">Reparatie en APK voor alle merken, en verkoop van gebruikte auto&rsquo;s en bussen.</p>
        </div>
        <ol class="lg:col-span-8 divide-y divide-paper-deep border-y border-paper-deep">
          {diensten.map((d) => (
            <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[5rem_1fr_1.2fr] gap-x-4 gap-y-1 py-5 sm:py-6 items-baseline">
              <span class="font-display font-extrabold text-2xl sm:text-3xl text-accent-text">{d.nr}</span>
              <h3 class="font-display font-extrabold text-xl sm:text-2xl normal-case tracking-normal">{d.kop}</h3>
              <p class="col-start-2 sm:col-start-3 text-ink-soft">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Occasions: donker vlak. Geen auto's of prijzen op de site zelf, die veranderen dagelijks. -->
    <section id="occasions" class="bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow mb-3 text-accent">Occasions</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl">Het actuele aanbod staat online.</h2>
            <p class="mt-5 text-mist max-w-xl text-lg">
              Personenauto&rsquo;s en bestelbussen, van goedkoop en degelijk tot jong gebruikt. Elke auto staat met foto&rsquo;s en kilometerstand op Autowereld.
            </p>
          </div>
          <div class="lg:col-span-5 lg:text-right">
            <a href={autowereld} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-accent text-ink font-display font-extrabold uppercase text-xl tracking-wide px-6 py-3.5 rounded-sm hover:bg-accent-deep">
              Bekijk het aanbod
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-[2fr_1fr_1fr]">
          {[1, 2, 3].map((n) => (
            <div class:list={["rounded-md border border-mist/25 bg-ink-deep/60 flex items-end p-5", n === 1 ? "aspect-[2/1] sm:aspect-auto sm:min-h-52" : "hidden sm:flex sm:min-h-52"]}>
              <span class="placeholder-label">{n === 1 ? 'Hier komt de koppeling met jullie voorraad' : 'Auto uit het aanbod'}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Over ons: alleen wat openbaar bekend is. De rest komt van de eigenaar. -->
    <section id="over" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5 lg:order-2">
          <Placeholder label="Hier komt een foto van de eigenaar" class="aspect-[4/3] lg:aspect-[4/5] rounded-md" />
        </div>
        <div class="lg:col-span-6 lg:order-1">
          <p class="eyebrow mb-3">Over Kleijn Auto&rsquo;s</p>
          <h2 class="text-3xl sm:text-4xl">Klein bedrijf, korte lijnen.</h2>
          <p class="mt-5 text-ink-soft text-lg">
            Kleijn Auto&rsquo;s zit aan De Leeuw 6 in Zuid-Beijerland. Reparatie en APK voor elke personenauto en lichte bedrijfswagen, en verkoop van gebruikte auto&rsquo;s en bussen. Het 06-nummer is het directe nummer van de zaak.
          </p>
          <div class="mt-8 rounded-md border border-dashed border-ink-soft/40 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komt jullie verhaal: sinds wanneer, wie er werkt en waar jullie goed in zijn</p>
          </div>
          <div class="mt-4 rounded-md border border-dashed border-ink-soft/40 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komen een paar echte Google-reviews, na jullie akkoord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Praktisch: adres, tijden en contact. Geen formulier: bellen of appen gaat sneller. -->
    <section id="praktisch">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Adres en tijden</p>
          <h2 class="text-3xl sm:text-4xl">Langskomen of bellen.</h2>
          <address class="not-italic mt-6 text-lg text-ink-soft">
            Kleijn Auto&rsquo;s<br />
            De Leeuw 6<br />
            3284 XV Zuid-Beijerland
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block font-display font-bold uppercase tracking-wide text-ink underline underline-offset-4 decoration-2 decoration-accent hover:decoration-ink">Routebeschrijving</a>
          <ul class="mt-8 space-y-2 text-lg">
            <li><a href={telHref} class="font-display font-extrabold text-2xl text-ink hover:text-accent-text">{tel}</a></li>
            <li><a href={waHref} class="text-ink underline underline-offset-4 decoration-accent decoration-2 hover:decoration-ink">WhatsApp op hetzelfde nummer</a></li>
            <li><a href={`mailto:${mail}`} class="text-ink underline underline-offset-4 decoration-accent decoration-2 hover:decoration-ink">{mail}</a></li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <table class="w-full text-left border-t border-paper-deep">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map(([dag, uren]) => (
                <tr class="border-b border-paper-deep">
                  <th scope="row" class="py-3 pr-4 font-display font-bold uppercase tracking-wide text-ink w-40">{dag}</th>
                  <td class:list={['py-3', uren === 'Gesloten' ? 'text-ink-soft' : 'text-ink']}>{uren}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-4 text-sm text-ink-soft">Tijden volgens het Google-bedrijfsprofiel. Even bellen voor je komt is nooit verkeerd.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink-deep text-mist">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display font-extrabold uppercase text-2xl text-paper">Kleijn Auto&rsquo;s</p>
        <p class="text-sm mt-1">De Leeuw 6, 3284 XV Zuid-Beijerland · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste belbalk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink-deep">
    <a href={telHref} class="bg-accent text-ink font-display font-extrabold uppercase text-lg tracking-wide py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-ink text-paper font-display font-extrabold uppercase text-lg tracking-wide py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>
