---
// Basislayout voor de demo. PUBLIC_VOORSTEL=1 zet de voorstelbalk en noindex aan;
// zonder die variabele zou dit de echte site kunnen worden.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://jarinijhoff.github.io');
const ogImage = new URL(`${base}og.jpg`, site).href;
import '../styles/global.css';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {voorstel && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#16214a" />
  </head>
  <body>
    {voorstel && (
      <div class="bg-ink-deep text-mist text-xs sm:text-sm px-4 py-2 text-center">
        Ontwerpvoorstel van NextUp Solutions voor Kleijn Auto's. Dit is niet de officiële website.
        <a href="https://nextupsolutions.nl" class="underline underline-offset-2 text-white ml-1 hover:text-accent">Over NextUp</a>
      </div>
    )}
    <slot />
  </body>
</html>
