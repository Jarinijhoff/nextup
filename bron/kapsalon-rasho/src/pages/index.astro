---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import logo from '../assets/logo.png';
import vlag from '../assets/vlag.jpg';

// Feiten van het Google-bedrijfsprofiel (adres, 06, openingstijden, score), hun
// Instagram en TikTok (wat ze doen, de zaak) en Weekblad 't Carillon (18-02-2025).
// Niets verzonnen; prijzen en eigen verhaal staan nog nergens online.
const tel = '06 87824990';
const telHref = 'tel:+31687824990';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Marktstraat+32,+4921+BG+Made';

// Openingstijden volgens het Google-profiel, gecontroleerd op 2 oktober 2026.
const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', '09:00 tot 19:00'],
  ['Woensdag', '09:00 tot 19:00'],
  ['Donderdag', '09:00 tot 19:00'],
  ['Vrijdag', '09:00 tot 19:00'],
  ['Zaterdag', '09:00 tot 19:00'],
  ['Zondag', '10:00 tot 15:00'],
];

const diensten = [
  { kop: 'Knippen', tekst: 'Kort, lang of een slick back. Vertel of laat zien wat je wilt.' },
  { kop: 'Fade', tekst: 'Van huid tot lengte, strak in de overgang.' },
  { kop: 'Baard en scheren', tekst: 'Je baard in model, of helemaal glad.' },
  { kop: 'Gezichtsbehandeling', tekst: 'Met stoom, als afsluiter na het knippen of scheren.' },
  { kop: 'Kinderen', tekst: 'Jongens knippen we ook. De kleinsten zitten in onze kinderauto.' },
];
---
<Layout
  title="Kapsalon Rasho, Made: barbier aan de Marktstraat, zonder afspraak"
  description="Barbier in Made. Knippen, fades, baard en scheren voor mannen en jongens. Loop binnen aan de Marktstraat 32, ook op zondag. Bel 06 87824990."
  bedrijf="Kapsalon Rasho"
  themeColor="#1c1d20"
  balkClass="bg-graphite text-white"
>
  <header class="bg-paper border-b border-fog">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 flex items-center justify-between gap-4 h-[4.5rem]">
      <a href="#top" class="flex items-center gap-3" aria-label="Kapsalon Rasho, naar boven">
        <Image src={logo} alt="" widths={[48, 96, 144]} sizes="48px" class="w-12 h-auto" loading="eager" />
        <span class="font-display font-black text-xl tracking-tight">Kapsalon Rasho</span>
      </a>
      <nav aria-label="Hoofdnavigatie" class="hidden md:block">
        <ul class="flex items-center gap-8 font-display font-bold">
          <li><a href="#knippen" class="hover:text-gold-text">Wat we doen</a></li>
          <li><a href="#zaak" class="hover:text-gold-text">De zaak</a></li>
          <li><a href="#tijden" class="hover:text-gold-text">Tijden en adres</a></li>
        </ul>
      </nav>
      <a href={telHref} class="hidden sm:inline-flex items-center gap-2 font-display font-bold border-2 border-graphite rounded-full px-4 py-1.5 hover:bg-graphite hover:text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        {tel}
      </a>
    </div>
  </header>

  <main id="top">
    <!-- Hero: de lamellenwand van de zaak als achtergrond, kop links, het logo groot
         rechts als beeld. Er is nog geen eigen foto van de zaak zonder klanten. -->
    <section class="bg-paper">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 pt-12 pb-16 sm:pt-20 sm:pb-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <p class="eyebrow text-gold-text mb-5">Barbier aan de Marktstraat in Made</p>
          <h1 class="text-[clamp(2.05rem,9.4vw,3.6rem)] sm:text-5xl lg:text-[4.25rem] leading-[0.98]">
            <span class="lg:whitespace-nowrap">Knippen en baard.</span><br />
            <span class="lg:whitespace-nowrap">Zonder afspraak.</span>
          </h1>
          <p class="mt-6 max-w-lg text-lg">
            Fades, knippen, baard en scheren voor mannen en jongens. Loop binnen aan de Marktstraat 32, ook op zondag. Bel gerust even of het druk is.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={telHref} class="btn-donker">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
              Bel {tel}
            </a>
            <a href={route} target="_blank" rel="noopener" class="font-display font-bold text-lg link-goud">Route naar de zaak</a>
          </div>
          <p class="mt-8 inline-flex items-center gap-2 font-display font-bold">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="text-gold"><path fill="currentColor" d="m12 2.5 2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8Z"/></svg>
            4,9 op Google, uit 209 reviews
          </p>
        </div>
        <div class="lamellen lg:col-span-5 order-1 lg:order-2 flex items-center justify-center py-8 sm:py-14 lg:py-0 lg:self-stretch lg:min-h-[30rem] rounded-sm">
          <Image src={logo} alt="Logo van Kapsalon Rasho, opgericht in 2024" widths={[260, 400, 520, 800]} sizes="(min-width: 1024px) 360px, 58vw" class="w-[58vw] max-w-[240px] sm:max-w-[300px] lg:max-w-[360px] h-auto" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- Wat we doen: lijst met lijnen, de prijzen komen van de zaak zelf. -->
    <section id="knippen" class="bg-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-gold-text mb-3">Wat we doen</p>
          <h2 class="text-3xl sm:text-4xl">Strak van fade tot baard.</h2>
          <p class="mt-5 text-steel max-w-sm">Voor mannen en jongens. Je loopt binnen en schuift aan; er werken meerdere barbers tegelijk.</p>
        </div>
        <div class="lg:col-span-8">
          <ul class="border-t-2 border-graphite">
            {diensten.map((d) => (
              <li class="grid sm:grid-cols-[13rem_1fr] gap-x-8 gap-y-1 py-5 border-b border-fog">
                <h3 class="text-xl">{d.kop}</h3>
                <p class="text-steel">{d.tekst}</p>
              </li>
            ))}
          </ul>
          <p class="aanlever mt-6 border-steel/40 text-steel">Hier komt jullie prijslijst, precies zoals jullie hem hanteren</p>
        </div>
      </div>
    </section>

    <!-- De zaak: donker vlak met het honingraatplafond als lijntekening. -->
    <section id="zaak" class="honingraat text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <Image src={vlag} alt="Tafelvlaggetjes met het logo van Kapsalon Rasho in de zaak" widths={[400, 640, 900]} sizes="(min-width: 1024px) 420px, 100vw" class="w-full h-auto aspect-[4/5] object-cover rounded-sm" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="eyebrow text-gold mb-3">De zaak</p>
          <h2 class="text-3xl sm:text-4xl">Sinds 2024 aan de Marktstraat.</h2>
          <p class="mt-5 text-lg text-white/85 max-w-xl">
            Een inloopzaak met vier stoelen, een bank om even te wachten en een kinderauto voor de jongste klanten. Op Google staan we op 4,9, uit 209 reviews, en we reageren er zelf op.
          </p>
          <div class="mt-8 space-y-4">
            <p class="aanlever border-slate/50 text-white/80">Hier komt jullie eigen verhaal: wie er knippen en hoe de zaak begon</p>
            <p class="aanlever border-slate/50 text-white/80">Hier komen drie echte Google-reviews, na jullie akkoord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tijden en adres: alles wat een inloopklant moet weten, in een oogopslag. -->
    <section id="tijden" class="bg-paper">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-gold-text mb-3">Tijden en adres</p>
          <h2 class="text-3xl sm:text-4xl">Loop gewoon binnen.</h2>
          <address class="not-italic mt-6 text-lg">
            Kapsalon Rasho<br />
            Marktstraat 32<br />
            4921 BG Made
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block font-display font-bold link-goud">Routebeschrijving</a>
          <p class="mt-8"><a href={telHref} class="font-display font-black text-3xl hover:text-gold-text">{tel}</a></p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <table class="w-full text-left border-t-2 border-graphite">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map(([dag, uren]) => (
                <tr class="border-b border-fog">
                  <th scope="row" class="py-3.5 pr-4 font-display font-bold w-40">{dag}</th>
                  <td class:list={['py-3.5 tabular-nums', uren === 'Gesloten' ? 'text-steel' : '']}>{uren}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <Placeholder label="Hier komt een foto van de zaak, zonder klanten in beeld" class="mt-8 aspect-[16/9] rounded-sm" />
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-graphite text-slate">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div class="flex items-center gap-4">
        <Image src={logo} alt="" widths={[64, 128]} sizes="64px" class="w-16 h-auto" loading="eager" />
        <div>
          <p class="font-display font-black text-2xl text-white tracking-tight">Kapsalon Rasho</p>
          <p class="text-sm mt-1">Marktstraat 32, 4921 BG Made · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a></p>
        </div>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="sm:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2">
    <a href={telHref} class="bg-graphite text-white font-display font-bold py-3.5 text-center">Bellen</a>
    <a href={route} target="_blank" rel="noopener" class="bg-gold text-graphite font-display font-bold py-3.5 text-center">Route</a>
  </div>
  <div class="sm:hidden h-[3.25rem] bg-graphite" aria-hidden="true"></div>
</Layout>
