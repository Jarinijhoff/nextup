---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import logo from '../assets/logo.png';

// Alle feiten komen van de eigen site (autorijschoolvannoort.nl: over, lesauto's,
// opleidingen, tarieven, contact), het Google-profiel (score) en de Facebookpagina.
// Niets verzonnen; lestijden, foto's en reviews levert de rijschool zelf aan.
const tel = '06 46625846';
const telHref = 'tel:+31646625846';
const tel2 = '06 25299112';
const tel2Href = 'tel:+31625299112';
const waHref = 'https://wa.me/31646625846';
const mail = 'j.noort3@chello.nl';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Kraanbaan+31,+2987+WB+Ridderkerk';

const nav = [
  ['#opleidingen', 'Opleidingen'],
  ['#lesautos', "Lesauto's"],
  ['#tarieven', 'Tarieven'],
  ['#over', 'Over ons'],
  ['#contact', 'Contact'],
];

// Opleidingen zoals de rijschool ze zelf beschrijft op de eigen site.
const opleidingen = [
  { kop: 'Rijbewijs B, schakel', tekst: 'Les in de Skoda Kamiq. De auto waarin je lest, is ook de auto waarmee je examen doet.' },
  { kop: 'Rijbewijs B, automaat', tekst: 'Les in de Skoda Kodiaq automaat. Een automaatles kost hetzelfde als een schakelles.' },
  { kop: 'E achter B, aanhanger', tekst: 'Losse lessen van 2 uur, of de dagopleiding: les en aansluitend examen op dezelfde dag. Die kiezen de meeste leerlingen.' },
  { kop: 'Rijles vanaf 16,5 jaar', tekst: 'Met 2toDrive begin je eerder. De training voor je begeleider regelen we ook.' },
  { kop: 'Opfriscursus', tekst: 'Wel een rijbewijs, maar even uit de oefening? Dan rijd je een paar lessen met ons mee.' },
  { kop: 'Faalangstexamen', tekst: 'Zie je erg op tegen het examen? Onze instructrice is ook faalangstinstructrice.' },
];

// Tarieven van de pagina "Tarieven schakel en automaat" op de huidige site.
const losse = [
  ['Losse les, 60 minuten', '€ 65,00'],
  ['Les van 120 minuten', '€ 130,00'],
  ['10-lessenkaart', '€ 640,00'],
  ['Praktijkexamen', '€ 285,00'],
  ['Tussentijdse toets', '€ 285,00'],
  ['Faalangstexamen', '€ 360,00'],
  ['Opfriscursus, per les', '€ 65,00'],
  ['Training begeleider 2toDrive', '€ 65,00'],
];
const pakketten = [
  { lessen: 20, prijs: '€ 1.572,00' },
  { lessen: 30, prijs: '€ 2.163,50' },
  { lessen: 35, prijs: '€ 2.473,50' },
  { lessen: 40, prijs: '€ 2.779,50' },
];
---
<Layout
  title="Autorijschool J. van Noort, Ridderkerk: rijles B, automaat en aanhanger"
  description="Familierijschool in Ridderkerk. Rijles in een Skoda, schakel of automaat, en E achter B. We halen je thuis op in Ridderkerk, Barendrecht en Rotterdam-Zuid. App 06 46625846."
  bedrijf="Autorijschool J. van Noort"
  themeColor="#18191b"
  balkClass="bg-paper text-ink"
>
  <header class="op-donker sticky top-0 z-20 bg-asphalt text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 flex items-center justify-between gap-4 h-16 sm:h-[4.5rem]">
      <a href="#top" class="shrink-0" aria-label="Autorijschool J. van Noort, naar boven">
        <Image src={logo} alt="Autorijschool J. van Noort" widths={[150, 220, 300, 440, 660]} sizes="(min-width: 640px) 220px, 150px" class="w-[150px] sm:w-[220px] h-auto" loading="eager" />
      </a>
      <nav aria-label="Hoofdnavigatie" class="hidden lg:block">
        <ul class="flex items-center gap-7 font-display font-bold">
          {nav.map(([href, label]) => (
            <li><a href={href} class="hover:text-yellow">{label}</a></li>
          ))}
        </ul>
      </nav>
      <a href={waHref} class="inline-flex items-center gap-2 bg-yellow text-asphalt font-display font-extrabold px-3.5 sm:px-4 py-2 rounded-sm hover:bg-yellow-deep">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6Z"/></svg>
        <span class="hidden sm:inline">App ons</span><span class="sm:hidden">App</span>
      </a>
    </div>
  </header>

  <main id="top">
    <!-- Hero: geel als het bord van het logo, kop links groot, de foto van de
         lesauto's komt rechts zodra de rijschool die aanlevert. -->
    <section class="bg-yellow text-navy">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 pt-12 pb-14 sm:pt-20 sm:pb-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow text-navy mb-5">Familierijschool in Ridderkerk</p>
          <h1 class="text-[clamp(2.6rem,12vw,3.4rem)] sm:text-5xl lg:text-[4.6rem] leading-[0.95]">
            Eén vaste instructeur. <span class="block">Tot je rijbewijs.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-asphalt">
            Rijles in een Skoda, schakel of automaat, en E achter B voor de aanhanger. We halen je thuis op in Ridderkerk, Barendrecht en Rotterdam-Zuid. Examen doe je bij het CBR in Barendrecht.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHref} class="btn-navy">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Z"/></svg>
              App over je eerste les
            </a>
            <a href={telHref} class="font-display font-extrabold text-lg link-streep">Of bel {tel}</a>
          </div>
          <p class="mt-8 inline-flex items-center gap-2 font-display font-bold text-asphalt">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 2.5 2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8Z"/></svg>
            5,0 op Google, uit 32 reviews
          </p>
        </div>
        <div class="lg:col-span-5">
          <Placeholder label="Hier komt een foto van jullie Skoda's met de aanhanger" class="aspect-[16/10] lg:aspect-[4/5] rounded-sm" />
        </div>
      </div>
    </section>

    <!-- Opleidingen: een lijst met lijnen, geen kaartjes. -->
    <section id="opleidingen" class="bg-paper">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-grey mb-3">Opleidingen</p>
          <h2 class="text-3xl sm:text-4xl text-navy">Auto, automaat of aanhanger.</h2>
          <p class="mt-5 text-grey max-w-sm">We zijn bevoegd voor alle categorieën, maar we geven vooral les voor het gewone rijbewijs B en voor E achter B.</p>
        </div>
        <ul class="lg:col-span-8 border-t-2 border-asphalt">
          {opleidingen.map((o) => (
            <li class="grid sm:grid-cols-[14rem_1fr] gap-x-8 gap-y-1 py-5 border-b border-paper-deep">
              <h3 class="text-xl text-asphalt">{o.kop}</h3>
              <p class="text-grey">{o.tekst}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Lesauto's: de nieuwe Skoda's zijn de trots van de rijschool, dus groot in beeld. -->
    <section id="lesautos" class="bg-white border-y border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24">
        <div class="max-w-2xl">
          <p class="eyebrow text-grey mb-3">Lesauto's</p>
          <h2 class="text-3xl sm:text-4xl text-navy">Je lest en doet examen in dezelfde auto.</h2>
        </div>
        <div class="mt-10 grid gap-10 md:grid-cols-2">
          <article>
            <Placeholder label="Hier komt een foto van de Kamiq" class="aspect-[3/2] rounded-sm" />
            <h3 class="mt-5 text-2xl text-asphalt">Skoda Kamiq, schakel</h3>
            <p class="mt-1 font-display font-bold text-grey">Model 2024</p>
            <p class="mt-3 text-grey">Met navigatie, cruise control en climate control. Je leert ook rijden met full map navigatie.</p>
          </article>
          <article class="md:mt-16">
            <Placeholder label="Hier komt een foto van de Kodiaq" class="aspect-[3/2] rounded-sm" />
            <h3 class="mt-5 text-2xl text-asphalt">Skoda Kodiaq, automaat</h3>
            <p class="mt-1 font-display font-bold text-grey">Model 2025, ook voor de aanhanger</p>
            <p class="mt-3 text-grey">Een ruime automaat met 7 versnellingen. Met deze auto rijd je ook de lessen en het examen voor E achter B.</p>
          </article>
        </div>
        <p class="mt-10 text-grey max-w-2xl">De lesauto's worden onderhouden bij een erkende dealer.</p>
      </div>
    </section>

    <!-- Tarieven: donker vlak, de bedragen in geel. Een rijschool wordt vooral op
         prijs vergeleken, dus alles staat in een oogopslag, ook op de telefoon. -->
    <section id="tarieven" class="op-donker bg-asphalt text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="eyebrow text-yellow mb-3">Tarieven</p>
            <h2 class="text-3xl sm:text-4xl">Wat het kost, zonder kleine letters.</h2>
          </div>
          <p class="lg:col-span-5 lg:col-start-8 text-mist">Schakel en automaat kosten hetzelfde. Bij een pakket zit het praktijkexamen erbij, met de lesauto.</p>
        </div>

        <h3 class="mt-12 text-xl text-yellow">Pakketten, lessen van 60 minuten</h3>
        <ul class="mt-4 grid grid-cols-2 lg:grid-cols-4 border-t border-asphalt-soft">
          {pakketten.map((p) => (
            <li class="py-6 pr-4 border-b border-asphalt-soft lg:border-b-0 lg:border-r lg:pl-6 lg:first:pl-0 lg:last:border-r-0">
              <p class="font-display font-extrabold text-4xl sm:text-5xl leading-none">{p.lessen}</p>
              <p class="mt-1 text-mist">lessen plus examen</p>
              <p class="mt-4 font-display font-extrabold text-xl text-yellow">{p.prijs}</p>
            </li>
          ))}
        </ul>

        <div class="mt-14 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h3 class="text-xl text-yellow">Losse lessen en examens</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Losse tarieven</caption>
              <tbody>
                {losse.map(([wat, prijs]) => (
                  <tr class="border-b border-asphalt-soft">
                    <th scope="row" class="py-3 pr-4 font-normal">{wat}</th>
                    <td class="py-3 text-right font-display font-bold tabular-nums whitespace-nowrap">{prijs}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="lg:col-span-4 lg:col-start-9 space-y-4">
            <p class="aanlever border-mist/50 text-mist">Hier komen de tarieven voor E achter B, met de dagopleiding</p>
            <p class="text-sm text-mist">Bedragen zoals ze nu op jullie site staan. Voor de echte site lopen we ze samen na.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Over: het familieverhaal in hun eigen woorden, met ruimte voor foto en reviews. -->
    <section id="over" class="bg-paper">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-6 lg:order-2">
          <p class="eyebrow text-grey mb-3">Over ons</p>
          <h2 class="text-3xl sm:text-4xl text-navy">Een rijschool van één familie.</h2>
          <div class="mt-6 space-y-4 text-lg max-w-xl">
            <p>Toen het te druk werd om alleen les te geven, haalde ook mijn vrouw haar papieren als instructeur, en later onze oudste zoon. Zo houden we de kwaliteit in huis: we geven les volgens hetzelfde principe.</p>
            <p>Je krijgt les van dezelfde instructeur, in een ontspannen sfeer en met een gezonde dosis humor. De lesstof krijg je stukje bij beetje.</p>
            <p>We halen je thuis op. Of je stapt in bij Zuidplein, bij de stations Lombardijen, Barendrecht of Zuid, of bij je school in Rotterdam-Zuid.</p>
          </div>
          <p class="mt-8 font-display font-extrabold text-2xl text-navy max-w-md">"Zonder tevreden klanten, géén nieuwe klanten."</p>
          <p class="mt-1 text-grey">Ons motto</p>
        </div>
        <div class="lg:col-span-5 lg:order-1 space-y-4">
          <Placeholder label="Hier komt een foto van jullie drieën bij de lesauto" class="aspect-[4/3] rounded-sm" />
          <p class="aanlever border-grey/40 text-grey">Hier komen drie echte Google-reviews van geslaagde leerlingen, na hun akkoord</p>
        </div>
      </div>
    </section>

    <!-- Contact: bellen en appen staan voorop, adres en werkgebied ernaast. -->
    <section id="contact" class="bg-white border-t border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-grey mb-3">Contact</p>
          <h2 class="text-3xl sm:text-4xl text-navy">Stuur een appje, dan plannen we je eerste les.</h2>
          <ul class="mt-8 space-y-3">
            <li><a href={telHref} class="font-display font-extrabold text-3xl text-asphalt hover:text-navy">{tel}</a></li>
            <li><a href={tel2Href} class="font-display font-bold text-xl text-asphalt hover:text-navy">{tel2}</a></li>
            <li class="pt-2"><a href={waHref} class="link-streep decoration-yellow">WhatsApp op 06 46625846</a></li>
            <li><a href={`mailto:${mail}`} class="link-streep decoration-yellow">{mail}</a></li>
          </ul>
        </div>
        <div class="lg:col-span-5 lg:col-start-8 space-y-8">
          <div>
            <h3 class="text-xl text-asphalt">Adres</h3>
            <address class="not-italic mt-2 text-grey">
              Autorijschool J. van Noort<br />
              Kraanbaan 31<br />
              2987 WB Ridderkerk
            </address>
            <a href={route} target="_blank" rel="noopener" class="mt-2 inline-block font-display font-bold link-streep decoration-yellow">Route</a>
          </div>
          <div>
            <h3 class="text-xl text-asphalt">Waar we lesgeven</h3>
            <p class="mt-2 text-grey">Ridderkerk, Barendrecht, Rotterdam-Zuid (IJsselmonde) en de gemeenten eromheen. Examens bij CBR Barendrecht.</p>
          </div>
          <p class="aanlever border-grey/40 text-grey">Hier komen jullie lestijden, bijvoorbeeld of er ook 's avonds en op zaterdag les is</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="op-donker bg-asphalt text-mist">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <Image src={logo} alt="Autorijschool J. van Noort" widths={[200, 400]} sizes="200px" class="w-[200px] h-auto" loading="eager" />
        <p class="text-sm mt-4">Kraanbaan 31, 2987 WB Ridderkerk · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a> · KvK 81425910</p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2">
    <a href={telHref} class="bg-asphalt text-white font-display font-extrabold py-3.5 text-center">Bellen</a>
    <a href={waHref} class="bg-yellow text-asphalt font-display font-extrabold py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-[3.25rem] bg-asphalt" aria-hidden="true"></div>
</Layout>
