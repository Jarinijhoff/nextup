---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';
import interieur from '../assets/interieur.jpg';

// Alle feiten hieronder komen van het Google-bedrijfsprofiel (adres, 06,
// openingstijden, poster "alleen op afspraak"), de Instagram-bio
// (@kapsalon_new_look) en de Fresha-vermelding van Kapsalon New Look.
// Prijzen zijn nergens online te vinden en staan dus als vlak.
const tel = '06 10925056';
const telHref = 'tel:+31610925056';
const waHref = 'https://wa.me/31610925056?text=' + encodeURIComponent('Hoi, ik wil graag een afspraak maken. Mijn naam is ... en ik kan op ...');
const instagram = 'https://www.instagram.com/kapsalon_new_look/';
const tiktok = 'https://www.tiktok.com/@kapsalonnewlook3';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Irisstraat+6,+2981+BN+Ridderkerk';

// Openingstijden volgens het Google-profiel (door het bedrijf bijgewerkt, zomer 2026).
const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', '09:00 tot 18:00'],
  ['Woensdag', '09:00 tot 18:00'],
  ['Donderdag', '09:00 tot 18:00'],
  ['Vrijdag', '09:00 tot 21:00'],
  ['Zaterdag', '09:00 tot 18:00'],
  ['Zondag', 'Gesloten'],
];

// Behandelingen zoals ze op Fresha en Instagram staan. Prijzen komen van de zaak.
const groepen = [
  { kop: 'Heren', items: ['Knippen', 'Knippen en baard', 'Hier komen de andere herenbehandelingen'] },
  { kop: 'Dames', items: ['Knippen', 'Highlights', 'Hier komen de andere damesbehandelingen'] },
  { kop: 'Kinderen', items: ['Knippen', 'Hier komt wat jullie voor kinderen doen'] },
  { kop: 'Specialiteiten', items: ['Locs', 'Hier komen de overige specialiteiten'] },
];
---
<Layout
  title="Kapsalon New Look, Ridderkerk: dames, heren en kinderen, op afspraak"
  description="Kapsalon New Look aan de Irisstraat 6 in Ridderkerk. Knippen voor dames, heren en kinderen, highlights en locs. Alleen op afspraak: app of bel 06 10925056."
  bedrijf="Kapsalon New Look"
  themeColor="#141414"
  fonts={['bricolage-grotesque-latin-wght-normal.woff2', 'manrope-latin-wght-normal.woff2']}
>
  <div id="top"></div>
  <Header />

  <main>
    <!-- Hero: donker vlak, tekst links, rechts het vlak voor een foto van de zaak.
         Geen beeldvullende foto: de enige eigen foto is te rommelig voor een hero. -->
    <section class="bg-ink text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-12 sm:pt-20 pb-12 sm:pb-20 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-gold mb-4">Kapsalon in Ridderkerk, sinds 2018</p>
          <h1 class="text-3xl min-[360px]:text-4xl sm:text-5xl lg:text-6xl [overflow-wrap:anywhere]">
            Dames, heren en kinderen. Alleen op afspraak.
          </h1>
          <p class="mt-6 max-w-xl text-lg text-mist">
            Geen inloop, geen wachten. Je appt een dag en tijd, wij bevestigen, en de stoel is van jou.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={waHref} class="knop text-lg px-6 py-3.5">App voor een afspraak</a>
            <a href={telHref} class="font-display font-bold text-lg link-lijn">Of bel {tel}</a>
          </div>
          <p class="mt-10 text-sm text-mist">
            <span class="font-display font-extrabold text-white text-xl align-middle">4,9</span> op Google, uit 69 reviews
          </p>
        </div>
        <div class="lg:col-span-5">
          <Placeholder label="Hier komt een foto van jullie zaak aan de Irisstraat" class="aspect-[4/3] lg:aspect-[4/5] rounded-md border border-white/10" />
        </div>
      </div>
    </section>

    <!-- Behandelingen: prijslijst-opbouw met lijnen. Prijzen komen van de zaak. -->
    <section id="behandelingen" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow mb-3">Behandelingen</p>
          <h2 class="text-3xl sm:text-4xl">Wat we doen, en wat het kost.</h2>
          <p class="mt-5 text-ink-soft max-w-sm">Zodat je dat niet meer hoeft te vragen. Prijzen vullen we samen in.</p>
        </div>
        <div class="lg:col-span-8 grid sm:grid-cols-2 gap-x-10 gap-y-8">
          {groepen.map((g) => (
            <div>
              <h3 class="text-xl border-b-2 border-gold pb-2">{g.kop}</h3>
              <ul class="divide-y divide-paper-deep">
                {g.items.map((it) => (
                  <li class="flex items-baseline justify-between gap-4 py-3">
                    <span class:list={[it.startsWith('Hier') ? 'placeholder-label text-ink-soft' : 'font-body font-semibold text-ink']}>{it}</span>
                    {!it.startsWith('Hier') && <span class="font-display font-bold text-gold-text whitespace-nowrap">&euro; ..,-</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Afspraak: zo werkt het, in drie stappen. Geen agenda-module: WhatsApp is wat ze nu al gebruiken. -->
    <section id="afspraak" class="bg-ink text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <p class="eyebrow text-gold mb-3">Afspraak maken</p>
          <h2 class="text-3xl sm:text-4xl">Een appje, en de stoel staat klaar.</h2>
          <ol class="mt-8 space-y-5 text-lg text-mist">
            <li class="flex gap-4"><span class="font-display font-extrabold text-gold text-2xl leading-none">1</span><span>App je naam, wat je wilt laten doen en wanneer je kunt.</span></li>
            <li class="flex gap-4"><span class="font-display font-extrabold text-gold text-2xl leading-none">2</span><span>Wij bevestigen je tijd, of stellen een andere voor.</span></li>
            <li class="flex gap-4"><span class="font-display font-extrabold text-gold text-2xl leading-none">3</span><span>Je komt op je tijd, zonder wachten.</span></li>
          </ol>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-md border border-white/15 bg-smoke p-6 sm:p-8">
            <p class="font-body text-mist text-sm">Voorbeeldbericht, al ingevuld als je op de knop drukt:</p>
            <p class="mt-3 font-body text-white text-lg">&ldquo;Hoi, ik wil graag een afspraak maken. Mijn naam is ... en ik kan op ...&rdquo;</p>
            <a href={waHref} class="knop mt-6 w-full justify-center text-lg py-3.5">Open WhatsApp</a>
            <p class="mt-4 text-sm text-mist">Liever bellen? <a href={telHref} class="link-lijn text-white">{tel}</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- De zaak: hun eigen interieurfoto van het Google-profiel. -->
    <section id="zaak" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <Image src={interieur} alt="Binnen bij Kapsalon New Look: ronde verlichte spiegels, zwarte wanden en een gouden lamp" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 640px, 100vw" quality={72} class="w-full aspect-[3/2] object-cover rounded-md" loading="lazy" style="object-position: 70% 50%" />
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">De zaak</p>
          <h2 class="text-3xl sm:text-4xl">Klein, donker en strak.</h2>
          <p class="mt-5 text-ink-soft text-lg">
            Kapsalon New Look zit aan de Irisstraat 6 in Ridderkerk. Een stoel, een goed gesprek en een kapsel waar je mee thuis durft te komen. Nieuwe knipsels staan op Instagram en TikTok.
          </p>
          <div class="mt-6 flex flex-wrap gap-4 font-body font-semibold">
            <a href={instagram} target="_blank" rel="noopener" class="link-lijn">Instagram</a>
            <a href={tiktok} target="_blank" rel="noopener" class="link-lijn">TikTok</a>
          </div>
          <div class="mt-8 rounded-md border border-dashed border-ink/30 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komt jullie verhaal: wie er knipt, sinds wanneer en waar jullie goed in zijn</p>
          </div>
          <div class="mt-4 rounded-md border border-dashed border-ink/30 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komen een paar van jullie 69 Google-reviews, na jullie akkoord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Praktisch: adres en tijden. -->
    <section id="praktisch">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Adres en tijden</p>
          <h2 class="text-3xl sm:text-4xl [overflow-wrap:anywhere]">Irisstraat 6, Ridderkerk.</h2>
          <address class="not-italic mt-6 text-lg text-ink-soft">
            Kapsalon New Look<br />
            Irisstraat 6<br />
            2981 BN Ridderkerk
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block font-body font-semibold link-lijn">Routebeschrijving</a>
          <ul class="mt-8 space-y-2 text-lg">
            <li><a href={telHref} class="font-display font-extrabold text-lg sm:text-2xl text-ink hover:text-gold-text">{tel}</a></li>
            <li><a href={waHref} class="link-lijn">WhatsApp op hetzelfde nummer</a></li>
          </ul>
        </div>
        <div class="lg:col-span-7">
          <table class="w-full text-left border-t border-paper-deep">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map(([dag, uren]) => (
                <tr class="border-b border-paper-deep">
                  <th scope="row" class="py-3 pr-4 font-display font-bold text-ink w-36 sm:w-44">{dag}</th>
                  <td class:list={['py-3', uren === 'Gesloten' ? 'text-ink-soft' : 'text-ink']}>{uren}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-4 text-sm text-ink-soft">Tijden volgens het Google-profiel. Alleen op afspraak, dus app of bel even van tevoren.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink-deep text-mist">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display font-extrabold text-2xl text-white">Kapsalon New Look</p>
        <p class="text-sm mt-1">Irisstraat 6, 2981 BN Ridderkerk · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-ink-deep">
    <a href={telHref} class="bg-white text-ink font-display font-bold text-base py-3.5 text-center">Bel</a>
    <a href={waHref} class="bg-gold text-ink font-display font-bold text-base py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>
