---
// Sticky donkere header met WhatsApp-knop: afspraak maken is de enige actie die telt.
const items = [
  ['#behandelingen', 'Behandelingen'],
  ['#afspraak', 'Afspraak'],
  ['#zaak', 'De zaak'],
  ['#praktisch', 'Adres en tijden'],
];
---
<header class="sticky top-0 z-20 bg-ink text-white border-b border-white/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="font-display font-extrabold text-base sm:text-xl tracking-tight leading-none whitespace-nowrap">
      New Look <span class="hidden md:inline font-body font-medium text-sm tracking-[0.12em] uppercase text-gold ml-1">Dames &amp; heren</span>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-6 font-body font-semibold text-sm whitespace-nowrap">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-gold">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="https://wa.me/31610925056" class="knop text-sm sm:text-base px-3.5 sm:px-5 py-2.5 whitespace-nowrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4Zm-3.3 4.2c-.2 0-.5 0-.8.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4l-.4-.2-1.9-.9c-.3-.1-.4-.2-.6.2l-.9 1.1c-.2.2-.3.2-.6.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.1.1-.2 0-.4 0-.5l-.9-2.1c-.2-.5-.4-.5-.6-.5h-.4Z"/></svg>
      <span class="hidden sm:inline">Afspraak maken</span><span class="sm:hidden">Afspraak</span>
    </a>
  </div>
</header>
