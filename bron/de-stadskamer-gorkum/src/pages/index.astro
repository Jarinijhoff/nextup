---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import logo from '../assets/logo-staand.png';

// Alle feiten komen van de eigen site (destadskamergorkum.nl: home, kaart van
// vandaag, voor- en nagerechten, borrel, reserveren, karaoke) en het
// Google-profiel (score). Niets verzonnen; foto's, eigen verhaal en reviews
// leveren Tamara en Henri zelf aan.
const tel = '06 18125003';
const telHref = 'tel:+31618125003';
const waHref = 'https://wa.me/31618125003';
const mail = 'mail@destadskamergorkum.nl';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Grote+Markt+19,+4201+EB+Gorinchem';

// Kaart van de dag zoals die op 2 oktober 2026 op hun site stond. Wisselt dagelijks.
const hoofd = [
  ['Parelhoen', '24,00'],
  ['Varkenshaas met pepersaus', '24,00'],
  ['Biefstuk a la tagliata', '25,00'],
  ['Runderpicanha met chimichurri', '25,00'],
  ['Kalfslever met uitjes en coppa', '24,00'],
  ['Vis van de dag', '24,00'],
  ['Vega van de dag', '24,00'],
];
const voor = [
  ['Uiensoep', '7,50'],
  ['Salade met geitenkaas', '10,50'],
  ['Vispalet', '10,50'],
  ['Carpaccio van coppa', '9,50'],
  ['Eendenborst carpaccio', '9,50'],
  ['Proeverijtje', '9,50'],
];
const na = [
  ['Appelcrumble met ijs', '7,50'],
  ['Dame blanche', '7,50'],
  ['Sterk ijsje, met espresso en koffielikeur', '8,00'],
  ['Port en kaas', '10,50'],
];
const borrel = [
  ['Bitterballen', '9,00'],
  ['Geitenkaasburgertjes', '8,50'],
  ['Lamsgehaktballetjes', '9,50'],
  ['Snackplank', '12,50'],
];
---
<Layout
  title="De Stadskamer, Gorinchem: borrel en diner aan de Grote Markt"
  description="Eten en drinken aan de Grote Markt in Gorinchem. Wisselende kaart met vlees, vis en vegetarisch, zoveel mogelijk huisgemaakt. Dinsdag tot en met zondag vanaf 17.00. Reserveren: 06 18125003."
  bedrijf="De Stadskamer"
  themeColor="#2a1419"
  balkClass="bg-cream text-wine"
>
  <header class="bg-wine text-cream border-b border-wine-soft">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 flex items-center justify-between gap-4 h-[4.5rem]">
      <a href="#top" class="font-display text-2xl leading-none" aria-label="De Stadskamer, naar boven">
        <span class="italic text-ember">de</span> Stadskamer
      </a>
      <nav aria-label="Hoofdnavigatie" class="hidden md:block">
        <ul class="flex items-center gap-8 font-semibold">
          <li><a href="#kaart" class="hover:text-ember">De kaart</a></li>
          <li><a href="#avonden" class="hover:text-ember">Dine &amp; Shine</a></li>
          <li><a href="#zaak" class="hover:text-ember">De zaak</a></li>
          <li><a href="#reserveren" class="hover:text-ember">Reserveren</a></li>
        </ul>
      </nav>
      <a href={waHref} class="hidden sm:inline-flex items-center gap-2 font-semibold border-2 border-cream/60 rounded-sm px-4 py-1.5 hover:border-ember hover:text-ember">Reserveren</a>
    </div>
  </header>

  <main id="top">
    <!-- Hero: hun motto groot, het staande logo als uithangbord ernaast. Er is nog
         geen eigen foto van de zaak; die komt in het vlak ernaast. -->
    <section class="bg-wine text-cream">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 pt-12 pb-16 sm:pt-20 sm:pb-24 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow text-ember mb-5">Aan de Grote Markt in Gorinchem</p>
          <h1 class="text-[clamp(2.9rem,14vw,4rem)] sm:text-5xl lg:text-[5.5rem] leading-[0.98]">
            Gewoon én anders.
          </h1>
          <p class="mt-6 max-w-xl text-lg text-blush">
            Borrel en diner met zicht op het oude stadhuis en de grote kerk. De kaart wisselt, met altijd vlees, vis en vegetarisch, en zoveel mogelijk huisgemaakt.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHref} class="btn-ember">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Z"/></svg>
              Reserveer via WhatsApp
            </a>
            <a href={telHref} class="font-semibold text-lg link-ember">Of bel {tel}</a>
          </div>
          <p class="mt-8 text-blush">Dinsdag tot en met zondag, van 17.00 tot 00.00 · 4,8 op Google, uit 150 reviews</p>
        </div>
        <div class="lg:col-span-5 flex items-stretch gap-5">
          <Image src={logo} alt="Logo: de Stadskamer" widths={[90, 140, 210]} sizes="(min-width: 1024px) 110px, 70px" class="w-[70px] lg:w-[110px] h-auto self-start" loading="eager" />
          <Placeholder label="Hier komt een foto van jullie terras aan de Grote Markt" class="flex-1 min-h-[16rem] lg:min-h-[26rem] rounded-sm" />
        </div>
      </div>
    </section>

    <!-- De kaart: als echte tekst, leesbaar op de telefoon, in plaats van drie losse pagina's. -->
    <section id="kaart" class="bg-cream">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-ember-text mb-3">De kaart</p>
            <h2 class="text-3xl sm:text-4xl">Wat de keuken vandaag maakt.</h2>
          </div>
          <p class="lg:col-span-4 lg:col-start-9 text-cocoa">De hoofdgerechten wisselen bijna elke dag. Bij alle hoofdgerechten serveren we verse groenten en frites.</p>
        </div>

        <div class="mt-12 grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h3 class="text-2xl">Hoofdgerechten van de dag</h3>
            <ul class="mt-4">
              {hoofd.map(([gerecht, prijs]) => (
                <li class="kaartregel text-lg"><span>{gerecht}</span><span class="stippel" aria-hidden="true"></span><span class="tabular-nums font-semibold">{prijs}</span></li>
              ))}
            </ul>
            <p class="aanlever mt-8 border-cocoa/40 text-cocoa">Hier komt de kaart van de dag, die jullie zelf elke dag kunnen bijwerken</p>
          </div>
          <div class="lg:col-span-4 lg:col-start-9 space-y-10">
            <div>
              <h3 class="text-2xl">Vooraf</h3>
              <ul class="mt-3">
                {voor.map(([gerecht, prijs]) => (
                  <li class="kaartregel"><span>{gerecht}</span><span class="stippel" aria-hidden="true"></span><span class="tabular-nums font-semibold">{prijs}</span></li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-2xl">Na</h3>
              <ul class="mt-3">
                {na.map(([gerecht, prijs]) => (
                  <li class="kaartregel"><span>{gerecht}</span><span class="stippel" aria-hidden="true"></span><span class="tabular-nums font-semibold">{prijs}</span></li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-2xl">Bij de borrel</h3>
              <ul class="mt-3">
                {borrel.map(([gerecht, prijs]) => (
                  <li class="kaartregel"><span>{gerecht}</span><span class="stippel" aria-hidden="true"></span><span class="tabular-nums font-semibold">{prijs}</span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <p class="mt-10 text-sm text-cocoa">Een greep uit de kaart van 2 oktober 2026, prijzen in euro.</p>
      </div>
    </section>

    <!-- Dine & Shine: hun karaoke-avonden met diner, een eigen gezicht van de zaak. -->
    <section id="avonden" class="bg-ember text-wine">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-20 grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-3">Karaoke-avonden</p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl">Dine &amp; Shine: karaoke en diner.</h2>
          <p class="mt-5 text-lg max-w-xl">Eerst samen eten, daarna de microfoon. Voor € 30 per persoon, drankjes niet inbegrepen. Inloop vanaf 18.00, we beginnen om 18.30.</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 space-y-4">
          <p class="aanlever border-wine/50">Hier komen de data van de volgende avonden</p>
          <a href={waHref} class="inline-flex font-bold text-lg underline underline-offset-4 decoration-2">Meld je aan via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- De zaak: ruimte voor hun eigen verhaal en foto's. -->
    <section id="zaak" class="bg-wine text-cream">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <Placeholder label="Hier komt een foto van jullie binnen, met de gedekte tafels" class="aspect-[4/5] rounded-sm" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="eyebrow text-ember mb-3">De zaak</p>
          <h2 class="text-3xl sm:text-4xl">Midden in het oude centrum.</h2>
          <div class="mt-5 space-y-4 text-lg text-blush max-w-xl">
            <p>Op ons terras zit je aan het Grote Marktplein. Binnen is het klein en knus. Kom voor de borrel, of blijf voor een diner.</p>
            <p>Onze keuken maakt zoveel mogelijk zelf, met aandacht voor waar het vandaan komt.</p>
          </div>
          <div class="mt-8 space-y-4">
            <p class="aanlever border-blush/40 text-cream/85">Hier komt jullie eigen verhaal: wie jullie zijn en hoe de Stadskamer begon</p>
            <p class="aanlever border-blush/40 text-cream/85">Hier komen drie echte Google-reviews, na akkoord van de gasten</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Reserveren: appen of bellen is wat ze nu al aanbieden. -->
    <section id="reserveren" class="bg-cream">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-ember-text mb-3">Reserveren</p>
          <h2 class="text-3xl sm:text-4xl">Stuur een appje, dan houden we een tafel vrij.</h2>
          <ul class="mt-8 space-y-3">
            <li><a href={telHref} class="font-display text-3xl hover:text-ember-text">{tel}</a></li>
            <li><a href={waHref} class="link-ember">WhatsApp op hetzelfde nummer</a></li>
            <li><a href={`mailto:${mail}`} class="link-ember">{mail}</a></li>
          </ul>
        </div>
        <div class="lg:col-span-5 lg:col-start-8 space-y-8">
          <div>
            <h3 class="text-2xl">Open</h3>
            <p class="mt-2 text-lg">Dinsdag tot en met zondag<br />17.00 tot 00.00</p>
          </div>
          <div>
            <h3 class="text-2xl">Adres</h3>
            <address class="not-italic mt-2 text-lg">Grote Markt 19<br />4201 EB Gorinchem</address>
            <a href={route} target="_blank" rel="noopener" class="mt-2 inline-block link-ember">Route</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-wine text-blush">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div class="flex items-end gap-4">
        <Image src={logo} alt="" widths={[40, 80]} sizes="40px" class="w-10 h-auto" loading="eager" />
        <p class="text-sm">De Stadskamer · Grote Markt 19, 4201 EB Gorinchem · <a href={telHref} class="underline underline-offset-2 hover:text-cream">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-cream">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2">
    <a href={telHref} class="bg-wine text-cream font-semibold py-3.5 text-center border-t border-wine-soft">Bellen</a>
    <a href={waHref} class="bg-ember text-wine font-bold py-3.5 text-center">Reserveren</a>
  </div>
  <div class="md:hidden h-[3.25rem] bg-wine" aria-hidden="true"></div>
</Layout>
