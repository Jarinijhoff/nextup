---
// Header ligt transparant over de herofoto, met lichte tekst. Op mobiel alleen
// het logo en de belknop; de navigatie staat onderaan in de vaste balk.
const items = [
  ['#kaart', 'De kaart'],
  ['#catering', 'Catering'],
  ['#over', 'Over ons'],
  ['#praktisch', 'Adres en tijden'],
];
---
<header class="absolute inset-x-0 top-0 z-20 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="font-display font-bold text-xl sm:text-2xl tracking-tight">
      Kwantung <span class="hidden min-[360px]:inline text-sun">·</span> <span class="hidden min-[360px]:inline font-body font-medium text-sm sm:text-base tracking-normal text-mist">Hoogerheide</span>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-7 font-body font-medium text-base">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-sun">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="tel:+31164612349" class="knop text-sm sm:text-base py-2.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span class="hidden sm:inline">0164 612 349</span><span class="sm:hidden">Bel</span>
    </a>
  </div>
</header>
