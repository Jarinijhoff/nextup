---
import { Picture, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Placeholder from '../components/Placeholder.astro';
import gevel from '../assets/gevel.jpg';
import buffet from '../assets/buffet.jpg';

// Alle feiten hieronder komen van de Facebookpagina (facebook.com/chuns888) en
// het Google-bedrijfsprofiel van Kwantung. Niets verzonnen; wat ontbreekt is
// een "Hier komt ..."-vlak.
const tel = '0164 612 349';
const telHref = 'tel:+31164612349';
const mail = 'Kwantunghoogerheide888@hotmail.com';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Raadhuisstraat+35,+4631+NA+Hoogerheide';
const facebook = 'https://www.facebook.com/chuns888/';

// Drie manieren om bij Kwantung te eten, in hun eigen woorden op Facebook:
// "Afhalen · In restaurant dineren · Terras aanwezig" en "Chinees Restaurant/Afhaal/Cateraar".
const manieren = [
  { kop: 'Afhalen', tekst: 'Bel je bestelling door, dan staat hij klaar als je binnenloopt.' },
  { kop: 'In het restaurant', tekst: 'Klein en knus, binnen aan tafel of bij mooi weer op het terras aan de Raadhuisstraat.' },
  { kop: 'Catering op locatie', tekst: 'Chinees buffet voor je feest, vereniging of bedrijf, met warmhoudbakken en al.' },
];

const kaartDelen = [
  'Hier komt de afhaalkaart, per categorie met prijzen',
  'Hier komt de kaart van het restaurant',
  'Hier komt de dagschotel van het krijtbord',
];
---
<Layout
  title="Kwantung Chinese Cuisine, Hoogerheide: afhalen, restaurant en catering"
  description="Chinees restaurant en afhaalcentrum aan de Raadhuisstraat 35 in Hoogerheide, met terras en catering op locatie. Bellen voor bestellen of reserveren: 0164 612 349."
  bedrijf="Kwantung Chinese Cuisine"
  themeColor="#0f4d27"
  fonts={['fraunces-latin-opsz-normal.woff2', 'work-sans-latin-wght-normal.woff2']}
>
  <div id="top"></div>

  <!-- Hero: hun eigen foto van de hoek Raadhuisstraat beeldvullend, tekst linksonder. -->
  <section class="relative min-h-[75svh] lg:min-h-[92vh] flex flex-col text-white overflow-hidden">
    <Picture
      src={gevel}
      alt="De hoek van Kwantung Chinese Cuisine aan de Raadhuisstraat in Hoogerheide, met terras"
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: 'absolute inset-0' }}
      class="h-full w-full object-cover"
      style="object-position: 50% 42%"
    />
    <!-- Donkere laag, zwaarder linksonder waar de tekst staat. -->
    <div class="absolute inset-0" aria-hidden="true" style="background:
      linear-gradient(to top, rgb(10 46 24 / 0.94) 0%, rgb(10 46 24 / 0.72) 38%, rgb(10 46 24 / 0.3) 70%, rgb(10 46 24 / 0.22) 100%),
      linear-gradient(to right, rgb(10 46 24 / 0.5) 0%, rgb(10 46 24 / 0) 60%);"></div>
    <Header />
    <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 mt-auto pt-40 pb-14 sm:pb-20 lg:pb-24">
      <p class="eyebrow text-sun mb-4">Chinees restaurant, afhaal en catering</p>
      <h1 class="text-[2.5rem]/[1.02] min-[360px]:text-4xl sm:text-5xl lg:text-6xl max-w-4xl">
        Chinees eten in Hoogerheide. Afhalen, aan tafel, of op jullie feest.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-mist">
        Raadhuisstraat 35, op de hoek. Bellen is bestellen of reserveren.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={telHref} class="knop text-lg px-6 py-3.5">Bel {tel}</a>
        <a href="#kaart" class="font-body font-semibold text-lg link-lijn">Bekijk de kaart</a>
      </div>
    </div>
  </section>

  <main>
    <!-- Drie manieren: tekstlijst met lijnen, geen kaartjes met iconen. -->
    <section class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16 grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-2xl sm:text-3xl">Drie manieren om bij ons te eten.</h2>
        </div>
        <ol class="lg:col-span-8 grid sm:grid-cols-3 gap-6 sm:gap-8">
          {manieren.map((m, i) => (
            <li class="border-t-2 border-leaf pt-4">
              <span class="font-display font-bold text-xl text-leaf-text">0{i + 1}</span>
              <h3 class="mt-2 text-xl">{m.kop}</h3>
              <p class="mt-2 text-ink-soft">{m.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- De kaart: dit is wat klanten nu nergens vinden. Vlakken, want prijzen verzinnen we niet. -->
    <section id="kaart" class="bg-leaf-deep text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-sun mb-3">De kaart</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl">Wat er te eten is, met de prijs erbij.</h2>
            <p class="mt-5 text-mist max-w-xl text-lg">
              Nu moet je bellen om te weten wat er is. Straks staat de hele kaart hier, leesbaar op je telefoon, met de dagschotel bovenaan.
            </p>
          </div>
          <div class="lg:col-span-5 lg:text-right">
            <a href={telHref} class="knop text-lg px-6 py-3.5">Bestellen: bel {tel}</a>
          </div>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {kaartDelen.map((label, i) => (
            <div class:list={['rounded-md border border-mist/25 bg-leaf-ink/50 p-5 flex flex-col justify-between', i === 0 ? 'min-h-56 sm:min-h-72' : 'min-h-40 sm:min-h-72']}>
              <span class="font-display font-bold text-2xl text-sun">0{i + 1}</span>
              <span class="placeholder-label">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Catering: hun eigen buffetfoto van Facebook. -->
    <section id="catering" class="border-b border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <Image src={buffet} alt="Chinees buffet van Kwantung in warmhoudbakken op locatie: kroepoek, groenten, kip in zoetzure saus" widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw" quality={70} class="w-full aspect-[4/3] object-cover rounded-md" loading="lazy" />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="eyebrow mb-3">Catering</p>
          <h2 class="text-3xl sm:text-4xl">Het buffet komt naar jullie toe.</h2>
          <p class="mt-5 text-ink-soft text-lg">
            Voor een feest, een vereniging of het bedrijf: een Chinees buffet op locatie, in warmhoudbakken, met borden en bestek erbij. Kwantung staat regelmatig in de Zuidwesthoek.
          </p>
          <div class="mt-6 rounded-md border border-dashed border-leaf/40 p-5">
            <p class="placeholder-label text-ink-soft">Hier komt wat er in een buffet zit, vanaf hoeveel personen en wat het kost</p>
          </div>
          <a href={telHref} class="mt-7 inline-block font-body font-semibold text-lg link-lijn">Bel voor een offerte</a>
        </div>
      </div>
    </section>

    <!-- Over ons: alleen wat openbaar bekend is. -->
    <section id="over">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <p class="eyebrow mb-3">Over Kwantung</p>
          <h2 class="text-3xl sm:text-4xl">Klein, knus en van de familie.</h2>
          <p class="mt-5 text-ink-soft text-lg">
            Kwantung zit op de hoek van de Raadhuisstraat in Hoogerheide. Chinees restaurant, afhaalcentrum en cateraar in een, met een terras voor de deur.
          </p>
          <div class="mt-8 rounded-md border border-dashed border-leaf/40 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komt jullie verhaal: sinds wanneer, wie er in de keuken staat en wat jullie het liefst maken</p>
          </div>
          <div class="mt-4 rounded-md border border-dashed border-leaf/40 p-5 sm:p-6">
            <p class="placeholder-label text-ink-soft">Hier komen een paar echte Google-reviews, na jullie akkoord</p>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <Placeholder label="Hier komt een foto van de keuken of het team" class="aspect-[4/3] lg:aspect-[4/5] rounded-md" />
        </div>
      </div>
    </section>

    <!-- Praktisch: adres, bellen, tijden. Geen formulier: bellen gaat sneller. -->
    <section id="praktisch" class="bg-paper-deep/60 border-t border-paper-deep">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">Adres en tijden</p>
          <h2 class="text-3xl sm:text-4xl">Langskomen of bellen.</h2>
          <address class="not-italic mt-6 text-lg text-ink-soft">
            Kwantung Chinese Cuisine<br />
            Raadhuisstraat 35<br />
            4631 NA Hoogerheide
          </address>
          <a href={route} target="_blank" rel="noopener" class="mt-3 inline-block font-body font-semibold link-lijn">Routebeschrijving</a>
          <ul class="mt-8 space-y-2 text-lg">
            <li><a href={telHref} class="font-display font-bold text-2xl text-leaf-text hover:text-leaf-ink">{tel}</a></li>
            <li><a href={`mailto:${mail}`} class="link-lijn break-all">{mail}</a></li>
            <li><a href={facebook} target="_blank" rel="noopener" class="link-lijn">Volg ons op Facebook</a></li>
          </ul>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="rounded-md border border-dashed border-leaf/40 p-5 sm:p-6 min-h-56 flex flex-col justify-between bg-paper">
            <p class="font-body font-semibold text-leaf-ink">Openingstijden</p>
            <p class="placeholder-label text-ink-soft">Hier komen jullie openingstijden, per dag, zodat Google en de site hetzelfde zeggen</p>
          </div>
          <p class="mt-4 text-sm text-ink-soft">Reserveren of bestellen kan telefonisch. Even bellen voor je komt is nooit verkeerd.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-leaf-ink text-mist">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <p class="font-display font-bold text-2xl text-white">Kwantung Chinese Cuisine</p>
        <p class="text-sm mt-1">Raadhuisstraat 35, 4631 NA Hoogerheide · <a href={telHref} class="underline underline-offset-2 hover:text-white">{tel}</a></p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-white">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2 border-t border-leaf-ink">
    <a href={telHref} class="bg-sun text-leaf-ink font-body font-semibold text-base py-3.5 text-center">Bel en bestel</a>
    <a href={route} target="_blank" rel="noopener" class="bg-leaf-deep text-white font-body font-semibold text-base py-3.5 text-center">Route</a>
  </div>
  <div class="md:hidden h-14" aria-hidden="true"></div>
</Layout>
