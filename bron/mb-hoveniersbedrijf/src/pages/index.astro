---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import logo from '../assets/logo.png';
import hero from '../assets/hero.jpg';
import pergola from '../assets/projecten/terras-pergola-kunstgras.jpg';
import cirkel from '../assets/projecten/cirkelbestrating-pergola.jpg';
import veranda from '../assets/projecten/veranda-terras.jpg';
import overkapping from '../assets/projecten/terras-overkapping-avond.jpg';
import voortuin from '../assets/projecten/voortuin-tegels.jpg';
import rondgras from '../assets/projecten/tuin-avond-cirkel-gras.jpg';

// Alle feiten komen van het Google-bedrijfsprofiel (06, score, 111 eigen
// projectfoto's), de Facebookpagina en de eigen Nextdoor-pagina (slogan, e-mail),
// en wat klanten in reviews beschrijven. Niets verzonnen; werkwijze, werkgebied
// en openingstijden levert het bedrijf zelf aan.
const tel = '06 21475050';
const telHref = 'tel:+31621475050';
const waHref = 'https://wa.me/31621475050';
const mail = 'Mbhoveniersbedrijf@gmail.com';

// Wat ze doen, afgeleid uit hun eigen projectfoto's en wat klanten beschrijven.
const diensten = [
  { kop: 'Tuinaanleg en renovatie', tekst: 'Voortuin of achtertuin, van kale grond tot een complete tuin.' },
  { kop: 'Bestrating', tekst: 'Terrassen met grote keramische tegels, klinkers en opritten. Oude stenen voeren we af.' },
  { kop: 'Kunstgras en gras', tekst: 'Kunstgras met stapstenen, of gewoon nieuw gras.' },
  { kop: 'Schuttingen en hekwerk', tekst: 'Hout, zwart of gaas, en de poort erbij.' },
  { kop: 'Overkappingen en pergola', tekst: 'Een pergola of veranda boven je terras, ook vlonders.' },
  { kop: 'Tuinverlichting', tekst: 'Wandlampen en spots, zodat je tuin ook in de avond klaar is.' },
];

const projecten = [
  { foto: pergola, tekst: 'Terras onder een zwarte pergola, met kunstgras' },
  { foto: cirkel, tekst: 'Klinkers in een cirkel rond de plantenbak' },
  { foto: overkapping, tekst: 'Zwarte tegels onder een glazen overkapping' },
  { foto: veranda, tekst: 'Nieuw terras onder de veranda' },
  { foto: rondgras, tekst: 'Rond grasvlak met verlichting' },
  { foto: voortuin, tekst: 'Voortuin opnieuw bestraat' },
];
---
<Layout
  title="MB hoveniersbedrijf, Waalwijk: een top tuin voor een top prijs"
  description="Hovenier in Waalwijk en omgeving. Tuinaanleg, bestrating, kunstgras, schuttingen en overkappingen. App 06 21475050 voor een offerte."
  bedrijf="MB hoveniersbedrijf"
  themeColor="#0f1418"
  balkClass="bg-tile text-night"
>
  <div id="top" class="relative bg-night text-white">
    <!-- Header ligt transparant over de foto. Het logo is druk en gemaakt voor
         een lichte achtergrond, dus het staat op een eigen wit plaatje. -->
    <header class="absolute top-0 inset-x-0 z-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 flex items-center justify-between gap-4 h-20 sm:h-28">
        <a href="#top" class="bg-white rounded-sm px-2 py-1" aria-label="MB hoveniersbedrijf, naar boven">
          <Image src={logo} alt="MB hoveniersbedrijf" widths={[120, 160, 240, 320, 480]} sizes="(min-width: 640px) 160px, 120px" class="w-[120px] sm:w-[160px] h-auto" loading="eager" />
        </a>
        <nav aria-label="Hoofdnavigatie" class="hidden md:block">
          <ul class="flex items-center gap-8 font-display font-bold">
            <li><a href="#diensten" class="hover:text-lime">Wat we doen</a></li>
            <li><a href="#projecten" class="hover:text-lime">Projecten</a></li>
            <li><a href="#offerte" class="hover:text-lime">Offerte</a></li>
          </ul>
        </nav>
        <a href={telHref} class="hidden sm:inline-flex items-center gap-2 font-display font-bold border-2 border-white/70 rounded-sm px-4 py-1.5 hover:border-lime hover:text-lime">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          {tel}
        </a>
      </div>
    </header>

    <!-- Hero: eigen foto van een opgeleverde tuin bij avond, beeldvullend. Donker
         verloop van onder en links, want daar staat de tekst op de lichte tegels. -->
    <section class="relative min-h-[78svh] lg:min-h-[96svh] flex items-end overflow-hidden">
      <Picture
        src={hero}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
        alt="Nieuw aangelegde achtertuin bij avond: grote lichte tegels, kunstgras met stapstenen en verlichte schuttingen"
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'absolute inset-0' }}
        class="hero-foto h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-night via-night/80 via-50% to-night/10 sm:via-night/55 sm:via-40% sm:to-transparent" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-night/70 via-night/20 via-50% to-transparent" aria-hidden="true"></div>
      <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-8 pb-12 sm:pb-16 pt-[36svh] sm:pt-36">
        <p class="eyebrow text-white sm:text-lime mb-4">Hovenier in Waalwijk</p>
        <h1 class="max-w-4xl text-[clamp(2.4rem,11vw,3.4rem)] sm:text-5xl lg:text-[5.25rem] leading-[0.95]">
          Een top tuin voor een top prijs.
        </h1>
        <div class="mt-6 lg:mt-8 grid gap-6 lg:grid-cols-12 lg:items-end">
          <p class="lg:col-span-6 text-lg text-white/90 max-w-xl">
            Tuinaanleg, bestrating, kunstgras, schuttingen en overkappingen. Voor je voortuin, achtertuin of oprit, in Waalwijk en omgeving.
          </p>
          <div class="lg:col-span-6 flex flex-wrap items-center gap-x-6 gap-y-4 lg:justify-end">
            <a href={waHref} class="btn-lime">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.8.7.8-2.7-.2-.3A8 8 0 0 1 12 4Z"/></svg>
              App voor een offerte
            </a>
            <a href={telHref} class="font-display font-bold text-lg link-lime">Of bel {tel}</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- Wat we doen: lijst met lijnen, geen kaartjes met iconen. -->
    <section id="diensten" class="bg-tile">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-leaf mb-3">Wat we doen</p>
          <h2 class="text-3xl sm:text-4xl">Van kale grond tot tuin waar je in wilt zitten.</h2>
          <p class="mt-5 text-moss max-w-sm">Op Google staan we op 4,6 uit 26 reviews, met meer dan honderd foto's van ons eigen werk.</p>
        </div>
        <ul class="lg:col-span-8 border-t-2 border-night">
          {diensten.map((d) => (
            <li class="grid sm:grid-cols-[15rem_1fr] gap-x-8 gap-y-1 py-5 border-b border-tile-deep">
              <h3 class="text-xl">{d.kop}</h3>
              <p class="text-moss">{d.tekst}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Projecten: het werk verkoopt zichzelf. Op mobiel swipe je erdoorheen. -->
    <section id="projecten" class="bg-night text-white">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 pt-16 sm:pt-24">
        <div class="grid gap-4 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-lime mb-3">Projecten</p>
            <h2 class="text-3xl sm:text-4xl">Opgeleverd werk.</h2>
          </div>
          <p class="lg:col-span-4 lg:col-start-9 text-haze">Een greep uit de foto's op ons Google-profiel. <span class="md:hidden">Swipe voor meer.</span></p>
        </div>
      </div>
      <ul class="projecten mt-10 pb-16 sm:pb-24 flex md:grid md:grid-cols-6 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory px-4 sm:px-8 md:mx-auto md:max-w-6xl">
        {projecten.map((p, i) => (
          <li class:list={['shrink-0 w-[82%] sm:w-[60%] md:w-auto snap-start', i === 0 ? 'md:col-span-4' : i === 1 ? 'md:col-span-2' : i < 4 ? 'md:col-span-3' : 'md:col-span-3']}>
            <figure>
              <Image src={p.foto} alt={p.tekst} widths={[360, 540, 720, 1000]} quality={70} sizes="(min-width: 768px) 50vw, 82vw" class:list={['w-full object-cover rounded-sm', i === 1 ? 'aspect-[4/3] md:aspect-[3/4.1] md:h-full' : 'aspect-[4/3]']} />
              <figcaption class="mt-3 text-sm text-haze">{p.tekst}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <!-- Offerte: bellen of appen is nu al hoe klanten hem bereiken. -->
    <section id="offerte" class="bg-tile">
      <div class="mx-auto max-w-6xl px-4 sm:px-8 py-16 sm:py-24 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-leaf mb-3">Offerte</p>
          <h2 class="text-3xl sm:text-4xl">Vertel wat je wilt, dan rekenen we het voor je uit.</h2>
          <p class="mt-5 text-lg max-w-lg">Stuur een appje of bel. Een paar foto's van je tuin zoals hij nu is helpen om meteen goed mee te denken.</p>
          <ul class="mt-8 space-y-3">
            <li><a href={telHref} class="font-display font-extrabold text-3xl hover:text-leaf">{tel}</a></li>
            <li><a href={waHref} class="link-lime">WhatsApp op hetzelfde nummer</a></li>
            <li><a href={`mailto:${mail}`} class="link-lime">{mail}</a></li>
          </ul>
          <p class="mt-8 text-moss">Werkgebied: Waalwijk en omgeving.</p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8 space-y-4">
          <p class="aanlever border-moss/40 text-moss">Hier komt hoe jullie werken, van het eerste appje tot de opgeleverde tuin</p>
          <p class="aanlever border-moss/40 text-moss">Hier komen drie echte Google-reviews, na akkoord van de klant</p>
          <p class="aanlever border-moss/40 text-moss">Hier komen de plaatsen waar jullie werken en de openingstijden</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-white text-moss border-t border-tile-deep">
    <div class="mx-auto max-w-6xl px-4 sm:px-8 py-10 grid gap-6 sm:grid-cols-2 sm:items-end">
      <div>
        <Image src={logo} alt="MB hoveniersbedrijf, een top tuin voor een top prijs" widths={[220, 440]} sizes="220px" class="w-[220px] h-auto" loading="eager" />
        <p class="text-sm mt-4">Waalwijk · <a href={telHref} class="underline underline-offset-2 hover:text-night">{tel}</a> · KvK 87735539</p>
      </div>
      <p id="privacy" class="text-xs sm:text-right">
        <a href="#privacy" class="underline underline-offset-2 hover:text-night">Privacy</a>: dit ontwerp plaatst geen cookies en verzamelt geen gegevens.
      </p>
    </div>
  </footer>

  <!-- Mobiel: vaste balk onderaan, want daar zit de duim. -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-20 grid grid-cols-2">
    <a href={telHref} class="bg-night text-white font-display font-bold py-3.5 text-center">Bellen</a>
    <a href={waHref} class="bg-lime text-night font-display font-bold py-3.5 text-center">WhatsApp</a>
  </div>
  <div class="md:hidden h-[3.25rem] bg-white" aria-hidden="true"></div>
</Layout>

<style>
  /* Uitsnede: de verlichte muur en het kunstgras in het midden houden; op een
     smal scherm naar links: schutting, kunstgras en stapstenen in beeld, de felle wandlampen erbuiten (anders zakt het contrast achter de kop). */
  .hero-foto { object-position: 50% 55%; }
  @media (max-width: 640px) { .hero-foto { object-position: 12% 50%; } }
  /* Geen scrollbalk onder de swipebare projecten op mobiel. */
  .projecten { scrollbar-width: none; }
  .projecten::-webkit-scrollbar { display: none; }
</style>
