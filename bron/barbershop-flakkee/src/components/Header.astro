---
// Header ligt transparant over de hero-foto, met lichte tekst. Op mobiel alleen
// naam en belknop; de ankers staan in de vaste balk onderaan.
const items = [
  ['#knippen', 'Knippen'],
  ['#zaak', 'De zaak'],
  ['#praktisch', 'Adres en tijden'],
];
const { tel, telHref } = Astro.props;
---
<header class="absolute top-0 inset-x-0 z-20 text-bone">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between gap-4 h-16 sm:h-20">
    <a href="#top" class="font-display text-2xl sm:text-3xl tracking-wide leading-none" aria-label="Barbershop Flakkee, naar boven">
      Barbershop <span class="text-brass">Flakkee</span>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:block">
      <ul class="flex items-center gap-7 font-display text-xl tracking-wide">
        {items.map(([href, label]) => (
          <li><a href={href} class="hover:text-brass">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={telHref} class="hidden sm:inline-flex items-center gap-2 border border-bone/60 font-display text-lg tracking-wide px-4 py-2 rounded-sm hover:border-brass hover:text-brass">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      {tel}
    </a>
  </div>
</header>
